# device dumps: persist/modemst/fsg hold IMEI + calibration; live DT holds the serial
backup/
dtb/
recovery/
# third-party/Apple sources fetched for reading
research/
shim/out/
xnu/out/
xnu/out-*/
__pycache__/
# built iOS root image (multi-GB; rebuild with lemonadep/m2-build-macbook.sh)
lemonadep/m2-artifacts/
# vendor firmware pulled from this phone's own /vendor (proprietary Qualcomm/OnePlus
# binaries; never redistributed -- re-pull with lemonadep/fw-gpu/pull.sh from your own device)
lemonadep/fw-gpu/
# decoded/raw kernel console log dumps pulled from the device during debugging
logs/
# QCA6490 firmware pulled from this phone's modem partition (proprietary; re-pull with
# lemonadep/tools/pull-wlan-fw.sh from your own device)
lemonadep/fw-wlan/

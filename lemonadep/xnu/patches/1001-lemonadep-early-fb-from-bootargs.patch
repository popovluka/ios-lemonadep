@@ -26,7 +36,26 @@ extern unsigned char iso_font[256 * 16];
 
 /* Initialized data must remain writable until disable, including panics. */
 static unsigned int early_row, early_col;
-static unsigned int early_started, early_disabled, early_panicking;
+static unsigned int early_started, early_panicking;
+/* Off until sweet_early_setup() has a usable 32-bpp framebuffer. */
+static unsigned int early_disabled = 1;
+
+void
+sweet_early_setup(const struct boot_args *args)
+{
+	const Boot_Video *v = &args->Video;
+	if (v->v_baseAddr == 0 || v->v_depth != 32 || (v->v_rowBytes & 3) ||
+	    v->v_width < 48u * 21u || v->v_height < 32u + EARLY_CELL_H ||
+	    v->v_rowBytes / 4 < v->v_width) {
+		return;	/* stays disabled: no framebuffer we can draw into */
+	}
+	/* VA=PA through the bootstrap TTBR0 block(s) start.s mapped. */
+	early_fb = (volatile uint32_t *)(uintptr_t)v->v_baseAddr;
+	early_width = (unsigned int)v->v_width;
+	early_height = (unsigned int)v->v_height;
+	early_stride = (unsigned int)(v->v_rowBytes / 4);
+	early_disabled = 0;
+}
 

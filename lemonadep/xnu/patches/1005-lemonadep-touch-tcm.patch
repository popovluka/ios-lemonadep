+/* lemonadep: chunked TCM command write. touch_msg_run caps one FIFO write at
+ * 3 bytes, so a payload longer than 2 bytes continues with CMD_CONTINUE_WRITE
+ * (the same mechanism Syna_tcm_oncell's syna_tcm_raw_write uses, just with a
+ * fixed 2-byte chunk instead of its configurable wr_chunk_size). */
+static int
+touch_tcm_write(uint8_t cmd, const uint8_t *payload, unsigned len)
+{
+	unsigned sent = 0;
+	/* One iteration minimum, so a bare (payload-less) command is still sent
+	 * when len == 0 (chunk == 0, tx == [cmd]). */
+	do {
+		unsigned chunk = len - sent;
+		if (chunk > 2) {
+			chunk = 2;
+		}
+		uint8_t tx[3];
+		tx[0] = sent == 0 ? cmd : TCM_CMD_CONTINUE_WRITE;
+		for (unsigned i = 0; i < chunk; ++i) {
+			tx[1 + i] = payload[sent + i];
+		}
+		int err = touch_msg(st.i2c_addr, tx, 1 + chunk, NULL, 0, false);
+		if (err) {
+			return err;
+		}
+		sent += chunk;
+	} while (sent < len);
+	return 0;
+}
+
+/* lemonadep: read one TCM message (header + payload + continuation, if any).
+ * *code is the header's report/status code; payload gets payload_length
+ * bytes (0 for an empty STATUS_OK/IDLE/BUSY response). */
+static int
+touch_tcm_read(uint8_t *code, uint8_t *payload, unsigned max_payload, unsigned *got_len)
+{
+	uint8_t hdr[5];
+	int err = touch_msg(st.i2c_addr, NULL, 0, hdr, sizeof(hdr), false);
+	if (err) {
+		return err;
+	}
+	if (hdr[0] != TCM_MARKER) {
+		return ENXIO;
+	}
+	*code = hdr[1];
+	unsigned payload_length = hdr[2] | ((unsigned)hdr[3] << 8);
+	*got_len = 0;
+	/* STATUS_IDLE/BUSY/CONTINUED_READ (out-of-sync) carry no trustworthy
+	 * length field; Syna_tcm_oncell's syna_tcm_read_message forces 0 for
+	 * exactly these, same as here. STATUS_OK's own length is real. */
+	if (*code == 0x00u /* STATUS_IDLE */ || *code == 0x02u /* STATUS_BUSY */ ||
+	    *code == TCM_STATUS_CONTINUED_READ) {
+		payload_length = 0;
+	}
+	if (payload_length == 0) {
+		return 0; /* hdr[4] is this message's padding byte */
+	}
+	if (payload_length > max_payload) {
+		return EIO;
+	}
+	payload[0] = hdr[4]; /* first payload byte already in the initial read */
+	unsigned remaining = payload_length - 1; /* more payload bytes still owed */
+	uint8_t cont[2 + 90];
+	/* Continuation always carries its own {marker,STATUS_CONTINUED_READ}
+	 * mini-header and the trailing padding byte, even when remaining == 0
+	 * (the whole payload fit in hdr[4], but the padding byte is still
+	 * unread -- leaving it would desync the next transaction's framing). */
+	unsigned contlen = 2 + remaining + 1;
+	if (contlen > sizeof(cont)) {
+		return EIO;
+	}
+	err = touch_msg(st.i2c_addr, NULL, 0, cont, contlen, false);
+	if (err) {
+		return err;
+	}
+	if (cont[0] != TCM_MARKER || cont[1] != TCM_STATUS_CONTINUED_READ) {
+		return EIO;
+	}
+	for (unsigned i = 0; i < remaining; ++i) {
+		payload[1 + i] = cont[2 + i];
+	}
+	*got_len = payload_length;
+	return 0;
+}
+
+static int
+touch_tcm_identify(uint8_t *mode)
+{
+	int err = touch_tcm_write(TCM_CMD_IDENTIFY, NULL, 0);
+	if (err) {
+		return err;
+	}
+	touch_wait(10);
+	uint8_t code, payload[32];
+	unsigned got;
+	err = touch_tcm_read(&code, payload, sizeof(payload), &got);
+	if (err) {
+		return err;
+	}
+	/* struct syna_tcm_identification: version(1B), mode(1B), ... */
+	if (code != TCM_STATUS_OK || got < 2) {
+		return EIO;
+	}
+	*mode = payload[1];
+	return 0;
+}
+
+static int
+touch_tcm_bringup(void)
+{
+	/* Vendor reset sequence (Syna_tcm_oncell's syna_tcm_reset). */
+	touch_gpio(st.reset_gpio, 0, 3, 3, true, false);
+	touch_wait(TCM_RESET_LOW_MS);
+	touch_gpio(st.reset_gpio, 0, 3, 3, true, true);
+	touch_wait(TCM_RESET_HIGH_MS);
+	uint8_t mode = 0, code, payload[32];
+	unsigned got;
+	int err = touch_tcm_identify(&mode);
+	if (err) {
+		printf("SWEET TOUCH: TCM identify failed err=%d\n", err);
+		return err;
+	}
+	if (mode != TCM_MODE_APPLICATION) {
+		printf("SWEET TOUCH: TCM mode=%#x, not application; requesting app firmware\n", mode);
+		err = touch_tcm_write(TCM_CMD_RUN_APP_FIRMWARE, NULL, 0);
+		if (err) {
+			return err;
+		}
+		touch_wait(100);
+		(void)touch_tcm_read(&code, payload, sizeof(payload), &got); /* discard response */
+		err = touch_tcm_identify(&mode);
+		if (err || mode != TCM_MODE_APPLICATION) {
+			printf("SWEET TOUCH: TCM did not reach application mode (mode=%#x err=%d)\n",
+			    mode, err);
+			return err ? err : EIO;
+		}
+	}
+	err = touch_tcm_write(TCM_CMD_SET_REPORT_CONFIG, tcm_report_cfg, sizeof(tcm_report_cfg));
+	if (err) {
+		printf("SWEET TOUCH: TCM set report config failed err=%d\n", err);
+		return err;
+	}
+	touch_wait(10);
+	err = touch_tcm_read(&code, payload, sizeof(payload), &got);
+	if (err || code != TCM_STATUS_OK) {
+		printf("SWEET TOUCH: TCM set report config response err=%d code=%#x\n", err, code);
+		return err ? err : EIO;
+	}
+	err = touch_tcm_write(TCM_CMD_ENABLE_REPORT, NULL, 0);
+	if (err) {
+		printf("SWEET TOUCH: TCM enable report failed err=%d\n", err);
+		return err;
+	}
+	touch_wait(10);
+	err = touch_tcm_read(&code, payload, sizeof(payload), &got);
+	if (err || code != TCM_STATUS_OK) {
+		printf("SWEET TOUCH: TCM enable report response err=%d code=%#x\n", err, code);
+		return err ? err : EIO;
+	}
+	printf("SWEET TOUCH: TCM bring-up ok, mode=%#x\n", mode);
+	return 0;
+}
+
+static int
+touch_tcm_poll(void)
+{
+	uint8_t code, payload[TCM_RECORD_LEN * TCM_MAX_FINGERS];
+	unsigned got;
+	int err = touch_tcm_read(&code, payload, sizeof(payload), &got);
+	if (err) {
+		return err;
+	}
+	if (code != TCM_REPORT_TOUCH) {
+		return 0; /* STATUS_IDLE/BUSY or an unrelated report: nothing to do */
+	}
+	if (got % TCM_RECORD_LEN) {
+		return EIO; /* our fixed per-object layout must divide evenly */
+	}
+	unsigned n = got / TCM_RECORD_LEN;
+	if (n > TCM_MAX_FINGERS) {
+		return EIO;
+	}
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	for (unsigned i = 0; i < n; ++i) {
+		const uint8_t *p = payload + i * TCM_RECORD_LEN;
+		unsigned id = p[0];
+		unsigned px = p[1] | ((unsigned)p[2] << 8);
+		unsigned py = p[3] | ((unsigned)p[4] << 8);
+		if (id >= TOUCH_MAX || (mask & (1u << id))) {
+			return EIO;
+		}
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+	}
+	touch_report(mask, x, y);
+	return 0;
+}

+	}
+	unsigned total = len + 2u, sent = 0;
+	unsigned chunk_space = st.bitbang ? (unsigned)sizeof(body) : 2u;
+	while (sent < total) {
+		unsigned chunk = total - sent;
+		if (chunk > chunk_space) {
+			chunk = chunk_space;
+		}
+		uint8_t tx[1 + sizeof(body)];
+		tx[0] = sent == 0 ? cmd : TCM_CMD_CONTINUE_WRITE;
+		for (unsigned i = 0; i < chunk; ++i) {
+			tx[1 + i] = body[sent + i];
+		}
+		int err = touch_msg(st.i2c_addr, tx, 1 + chunk, NULL, 0, false);
+		if (err) {
+			return err;
+		}
+		sent += chunk;
+	}
+	return 0;
+}
+
+/* lemonadep: read one TCM message (header + payload + continuation, if any).
+ * *code is the header's report/status code; payload gets payload_length
+ * bytes (0 for an empty STATUS_OK/IDLE/BUSY response). */
+static int
+touch_tcm_read(uint8_t *code, uint8_t *payload, unsigned max_payload, unsigned *got_len)
+{
+	uint8_t hdr[5];
+	int err = touch_msg(st.i2c_addr, NULL, 0, hdr, sizeof(hdr), false);
+	if (err) {
+		return err;
+	}
+	if (hdr[0] != TCM_MARKER) {
+		if (!st.hdr_logged) {
+			st.hdr_logged = true;
+			printf("SWEET TOUCH: no TCM marker: %02x %02x %02x %02x %02x\n",
+			    hdr[0], hdr[1], hdr[2], hdr[3], hdr[4]);
+		}
+		return ENXIO;
+	}
+	*code = hdr[1];
+	unsigned payload_length = hdr[2] | ((unsigned)hdr[3] << 8);
+	*got_len = 0;
+	/* STATUS_IDLE/BUSY/CONTINUED_READ (out-of-sync) carry no trustworthy
+	 * length field; Syna_tcm_oncell's syna_tcm_read_message forces 0 for
+	 * exactly these, same as here. STATUS_OK's own length is real. */
+	if (*code == 0x00u /* STATUS_IDLE */ || *code == 0x02u /* STATUS_BUSY */ ||
+	    *code == TCM_STATUS_CONTINUED_READ) {
+		payload_length = 0;
+	}
+	if (payload_length == 0) {
+		return 0; /* hdr[4] is this message's padding byte */
+	}
+	if (payload_length > max_payload) {
+		return EIO;
+	}
+	payload[0] = hdr[4]; /* first payload byte already in the initial read */
+	unsigned remaining = payload_length - 1; /* more payload bytes still owed */
+	uint8_t cont[2 + 90];
+	/* Continuation always carries its own {marker,STATUS_CONTINUED_READ}
+	 * mini-header and the trailing padding byte, even when remaining == 0
+	 * (the whole payload fit in hdr[4], but the padding byte is still
+	 * unread -- leaving it would desync the next transaction's framing). */
+	unsigned contlen = 2 + remaining + 1;
+	if (contlen > sizeof(cont)) {
+		return EIO;
+	}
+	err = touch_msg(st.i2c_addr, NULL, 0, cont, contlen, false);
+	if (err) {
+		return err;
+	}
+	if (cont[0] != TCM_MARKER || cont[1] != TCM_STATUS_CONTINUED_READ) {
+		return EIO;
+	}
+	for (unsigned i = 0; i < remaining; ++i) {
+		payload[1 + i] = cont[2 + i];
+	}
+	*got_len = payload_length;
+	return 0;
+}
+
+/*
+ * Read until a message other than STATUS_IDLE/BUSY arrives, up to tries x
+ * 10 ms. ENXIO (no 0xA5 marker, or address NACK while the IC is busy) means
+ * "nothing yet".
+ */
+static int
+touch_tcm_wait_msg(uint8_t *code, uint8_t *payload, unsigned max, unsigned *got,
+    unsigned tries)
+{
+	int err = ETIMEDOUT;
+	for (unsigned i = 0; i < tries; ++i) {
+		err = touch_tcm_read(code, payload, max, got);
+		if (!err && *code != 0x00u && *code != 0x02u) {
+			return 0;
+		}
+		if (err && err != ENXIO) {
+			return err;
+		}
+		touch_wait(10);
+	}
+	return err ? err : ETIMEDOUT;
+}
+
+/* Send a command, then wait for its STATUS_OK, skipping unrelated reports
+ * (codes >= 0x10) that may arrive first. */
+static int
+touch_tcm_cmd(uint8_t cmd, const uint8_t *payload, unsigned len)
+{
+	int err = touch_tcm_write(cmd, payload, len);
+	if (err) {
+		return err;
+	}
+	uint8_t code = 0, resp[88];
+	unsigned got = 0;
+	for (unsigned n = 0; n < 8; ++n) {
+		err = touch_tcm_wait_msg(&code, resp, sizeof(resp), &got, 50);
+		if (err) {
+			printf("SWEET TOUCH: TCM cmd %#x: no response (err=%d)\n", cmd, err);
+			return err;
+		}
+		if (code == TCM_STATUS_OK) {
+			return 0;
+		}
+		if (code < 0x10u) {
+			printf("SWEET TOUCH: TCM cmd %#x: status %#x\n", cmd, code);
+			return EIO;
+		}
+	}
+	return EIO;
+}
+
+static int
+touch_tcm_bringup(void)
+{
+	/* Vendor power-on tail (syna_power_control): reset low 10 ms, high 80 ms. */
+	touch_gpio(st.reset_gpio, 0, 3, 3, true, false);
+	touch_wait(TCM_RESET_LOW_MS);
+	touch_gpio(st.reset_gpio, 0, 3, 3, true, true);
+	touch_wait(TCM_RESET_HIGH_MS);
+	uint8_t code = 0, payload[88];
+	unsigned got = 0;
+	/*
+	 * After reset the application firmware posts an unsolicited
+	 * REPORT_IDENTIFY; the vendor driver fills id_info from it
+	 * (syna_tcm_reset -> syna_tcm_identify(tcm_info, false)). Payload =
+	 * struct syna_tcm_identification: version, mode, part_number[16], ...
+	 */
+	int err = touch_tcm_wait_msg(&code, payload, sizeof(payload), &got, 30);
+	printf("SWEET TOUCH: TCM after reset: err=%d code=%#x len=%u mode=%#x\n",
+	    err, code, got, got > 1 ? payload[1] : 0u);
+	if (err || code != TCM_REPORT_IDENTIFY || got < 2) {
+		err = touch_tcm_write(TCM_CMD_IDENTIFY, NULL, 0);
+		for (unsigned n = 0; !err && n < 8; ++n) {
+			err = touch_tcm_wait_msg(&code, payload, sizeof(payload), &got, 50);
+			if (!err && (code == TCM_STATUS_OK || code == TCM_REPORT_IDENTIFY)) {
+				break;
+			}
+		}
+		if (err || (code != TCM_STATUS_OK && code != TCM_REPORT_IDENTIFY) || got < 2) {
+			printf("SWEET TOUCH: TCM identify failed err=%d code=%#x len=%u\n", err, code, got);
+			return err ? err : EIO;
+		}
+	}
+	if (payload[1] != TCM_MODE_APPLICATION) {
+		printf("SWEET TOUCH: TCM mode=%#x, not application; requesting app firmware\n", payload[1]);
+		(void)touch_tcm_write(TCM_CMD_RUN_APP_FIRMWARE, NULL, 0);
+		touch_wait(100);
+		for (unsigned n = 0; n < 8; ++n) {
+			err = touch_tcm_wait_msg(&code, payload, sizeof(payload), &got, 50);
+			if (err || code == TCM_REPORT_IDENTIFY) {
+				break;
+			}
+		}
+		if (err || code != TCM_REPORT_IDENTIFY || got < 2 || payload[1] != TCM_MODE_APPLICATION) {
+			printf("SWEET TOUCH: TCM did not reach application mode (err=%d code=%#x mode=%#x)\n",
+			    err, code, got > 1 ? payload[1] : 0u);
+			return err ? err : EIO;
+		}
+	}
+	err = touch_tcm_cmd(TCM_CMD_SET_REPORT_CONFIG, tcm_report_cfg, sizeof(tcm_report_cfg));
+	if (err) {
+		printf("SWEET TOUCH: TCM set report config failed err=%d\n", err);
+		return err;
+	}
+	/* syna_tcm_enable_report sends one payload byte, the report type. Touch
+	 * reports are normally on already, so a refusal here is not fatal. */
+	const uint8_t rep_touch = TCM_REPORT_TOUCH;
+	err = touch_tcm_cmd(TCM_CMD_ENABLE_REPORT, &rep_touch, 1);
+	if (err) {
+		printf("SWEET TOUCH: TCM enable touch report: err=%d (continuing)\n", err);
+	}
+	printf("SWEET TOUCH: TCM bring-up ok, mode=%#x\n", payload[1]);
+	return 0;
+}
+
+/*
+ * The firmware's own default touch report on this board, read off live
+ * reports by blahajcoding/op9pro-mainline-poc (patch 0002, struct
+ * tcm_report_point): a 7-byte prefix (FPS, 0D buttons, gesture, padding)
+ * then one 12-byte entry per object -- {idx:4 class:4}, x le16, y le16, z,
+ * major le16, minor le16, unknown le16. Class 0 means "no object". Used when
+ * the length doesn't match our own SET_REPORT_CONFIG layout, so touch works
+ * whether or not this firmware honours that command.
+ */
+#define TCM_NATIVE_PREFIX 7u
+#define TCM_NATIVE_RECORD 12u
+
+static int
+touch_tcm_poll(void)
+{
+	uint8_t code, payload[88];
+	unsigned got;
+	int err = touch_tcm_read(&code, payload, sizeof(payload), &got);
+	if (err) {
+		return err;
+	}
+	if (code != TCM_REPORT_TOUCH) {
+		return 0; /* STATUS_IDLE/BUSY or an unrelated report: nothing to do */
+	}
+	bool native = got >= TCM_NATIVE_PREFIX &&
+	    (got - TCM_NATIVE_PREFIX) % TCM_NATIVE_RECORD == 0;
+	if (!native && got % TCM_RECORD_LEN) {
+		if (!st.fmt_logged) {
+			st.fmt_logged = true;
+			printf("SWEET TOUCH: touch report len %u fits neither layout\n", got);
+		}
+		return EIO;
+	}
+	unsigned rec = native ? TCM_NATIVE_RECORD : TCM_RECORD_LEN;
+	unsigned base = native ? TCM_NATIVE_PREFIX : 0u;
+	unsigned n = (got - base) / rec;
+	if (n > TCM_MAX_FINGERS) {
+		return EIO;
+	}
+	if (!st.fmt_logged) {
+		st.fmt_logged = true;
+		printf("SWEET TOUCH: touch report len %u -> %s layout, %u object(s)\n",
+		    got, native ? "firmware-native" : "configured", n);
+	}
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	for (unsigned i = 0; i < n; ++i) {
+		const uint8_t *p = payload + base + i * rec;
+		unsigned id, px, py;
+		if (native) {
+			if ((p[0] >> 4) == 0u) {
+				continue; /* classification 0: no object */
+			}
+			id = p[0] & 0x0fu;
+			px = p[1] | ((unsigned)p[2] << 8);
+			py = p[3] | ((unsigned)p[4] << 8);
+		} else {
+			id = p[0];
+			px = p[1] | ((unsigned)p[2] << 8);
+			py = p[3] | ((unsigned)p[4] << 8);
+		}
+		if (id >= TOUCH_MAX || (mask & (1u << id))) {
+			return EIO;
+		}
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+	}
+	touch_report(mask, x, y);
+	return 0;
+}

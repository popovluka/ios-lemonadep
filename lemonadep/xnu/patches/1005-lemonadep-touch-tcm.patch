+
+static bool
+bb_scl_high(void)
+{
+	bb_release(st.scl_gpio);
+	for (unsigned i = 0; i < 20000 && !bb_get(st.scl_gpio); i++) {  /* clock stretching */
+		bb_ndelay(1000);

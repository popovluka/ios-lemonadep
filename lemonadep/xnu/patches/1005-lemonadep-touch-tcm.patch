+	if (SecureDTGetProperty(entry, "protocol", &prop, &psize) != kSuccess || psize != 4 ||
+	    ((const char *)prop)[0] != 't' || ((const char *)prop)[1] != 'c' ||
+	    ((const char *)prop)[2] != 'm') {

+	bb_low(st.sda_gpio);
+	bb_ndelay(BB_HALF_NS);
+	(void)bb_scl_high();
+	bb_ndelay(BB_HALF_NS);
+	bb_release(st.sda_gpio);
+	bb_ndelay(BB_HALF_NS);

+	keys_gpio_apid = keys_find_apid(keys_gpio_ppid_override != KEYS_NO_APID ? keys_gpio_ppid_override : 0x4c1, count);
+	printf("SWEET KEYS: pon-ppid=%#x gpio-ppid=%#x kpdpwr-bit=%#x resin-bit=%#x\n",
+	    keys_pon_ppid_override != KEYS_NO_APID ? keys_pon_ppid_override : 0x008u,
+	    keys_gpio_ppid_override != KEYS_NO_APID ? keys_gpio_ppid_override : 0x4c1u,

@@ -12,6 +12,7 @@
 #include <kern/sched_prim.h>
 #include <machine/machine_routines.h>
 #include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern void sweet_hid_key(int key, int down);
@@ -23,12 +24,32 @@
 #define KEYS_PON_RT      0x0810u
 #define KEYS_GPIO_RT     0xc110u
 #define KEYS_NO_APID     0xffffu
+/* gen-2 PM6150 (sweet) RT_STS bits; PMK8350 (lemonadep) is gen-3: BIT(7)/BIT(6) */
+#define KEYS_PON_KPDPWR_BIT_DEFAULT  0x01u
+#define KEYS_PON_RESIN_BIT_DEFAULT   0x02u
 
 static vm_offset_t keys_core, keys_obs, keys_cnfg;
 static uint16_t keys_pon_apid = KEYS_NO_APID, keys_gpio_apid = KEYS_NO_APID;
 static uint32_t keys_version, keys_last_status;
 static bool keys_started;
 static int keys_sleep_chan;
+/*
+ * ADT /buttons overrides (lemonadep: PMK8350 PON_HLOS is a different SPMI
+ * peripheral than sweet's PM6150 PON, and being gen-3 PON its RT_STS bit
+ * positions for KPDPWR/RESIN differ too -- see tools/mkadt.py lemonadep
+ * profile for the sourced values). Absent on sweet: every lookup below
+ * keeps its sweet default (PPID found by ppid-scan at 0x008/0x4c1, bits
+ * 0x01/0x02), so sweet's kernel behaviour is unchanged.
+ */
+static uint16_t keys_pon_ppid_override = KEYS_NO_APID, keys_gpio_ppid_override = KEYS_NO_APID;
+static uint32_t keys_kpdpwr_bit = KEYS_PON_KPDPWR_BIT_DEFAULT, keys_resin_bit = KEYS_PON_RESIN_BIT_DEFAULT;
+/* lemonadep only (see tools/mkadt.py swap-volume-keys): the retail
+ * devicetree reassigns RESIN to KEY_VOLUMEUP and the GPIO6 "vol_up" node
+ * to KEY_VOLUMEDOWN -- the reverse of sweet's own PM6150/PM6150L wiring,
+ * which now[1]/now[2] below were written to match. Confirmed on-device
+ * 2026-10-22: without this, pressing one physical button raised the
+ * other's function (volume up/down were swapped end to end). */
+static bool keys_swap_vol;
 
 static uint32_t
 keys_rd(vm_offset_t base, uint32_t off)
@@ -101,7 +122,25 @@
 		uint8_t pon = 0, gpio = 0;
 		bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
 		bool gok = keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
-		int now[3] = {!!(pon & 1u), !(gpio & 1u), !!(pon & 2u)};
+		/* Swapped (lemonadep): slot 1 is RESIN (gated by pok), slot 2 is
+		 * GPIO (gated by gok) -- the reverse of the unswapped layout, so
+		 * the validity gate below must swap with it. A ternary between
+		 * two compound literals cannot initialize an array in C (gcc/
+		 * clang: "array initializer must be an initializer list"), so
+		 * assign element by element instead. */
+		int now[3];
+		int gpio_slot;
+		if (keys_swap_vol) {
+			now[0] = !!(pon & keys_kpdpwr_bit);
+			now[1] = !!(pon & keys_resin_bit);
+			now[2] = !(gpio & 1u);
+			gpio_slot = 2;
+		} else {
+			now[0] = !!(pon & keys_kpdpwr_bit);
+			now[1] = !(gpio & 1u);
+			now[2] = !!(pon & keys_resin_bit);
+			gpio_slot = 1;
+		}
 		if (!pok || !gok) {
 			if ((errors++ % 250u) == 0) {
 				printf("SWEET KEYS: read error pon-ok=%d gpio-ok=%d arb-status=%#x\n",
@@ -111,7 +150,7 @@
 			errors = 0;
 		}
 		for (int k = 0; k < 3; ++k) {
-			if ((k == 1 ? gok : pok) && now[k] != state[k]) {
+			if ((k == gpio_slot ? gok : pok) && now[k] != state[k]) {
 				state[k] = now[k];
 				printf("SWEET KEYS: key=%d down=%d pon=%#x gpio4:c110=%#x\n",
 				    k, state[k], pon, gpio);
@@ -127,6 +166,7 @@
 {
 	int enabled = 1;
 	thread_t thread;
+	DTEntry entry;
 	if (keys_started) {
 		return;
 	}
@@ -136,6 +176,31 @@
 		printf("SWEET KEYS: disabled (sweetkeys=0)\n");
 		return;
 	}
+	if (SecureDTLookupEntry(NULL, "/buttons", &entry) == kSuccess) {
+		void const *prop;
+		unsigned int psize;
+		uint32_t v;
+		if (SecureDTGetProperty(entry, "pon-ppid", &prop, &psize) == kSuccess && psize == 4) {
+			keys_pon_ppid_override = (uint16_t)(*(const uint32_t *)prop & 0xfffu);
+		}
+		if (SecureDTGetProperty(entry, "vol-down-gpio-ppid", &prop, &psize) == kSuccess && psize == 4) {
+			keys_gpio_ppid_override = (uint16_t)(*(const uint32_t *)prop & 0xfffu);
+		}
+		if (SecureDTGetProperty(entry, "pon-kpdpwr-bit", &prop, &psize) == kSuccess && psize == 4) {
+			keys_kpdpwr_bit = *(const uint32_t *)prop;
+		}
+		if (SecureDTGetProperty(entry, "pon-resin-bit", &prop, &psize) == kSuccess && psize == 4) {
+			keys_resin_bit = *(const uint32_t *)prop;
+		}
+		if (SecureDTGetProperty(entry, "pon-subtype-gen3", &prop, &psize) == kSuccess && psize == 4) {
+			v = *(const uint32_t *)prop;
+			printf("SWEET KEYS: ADT expects gen-3 PON subtype %#x\n", v);
+		}
+		if (SecureDTGetProperty(entry, "swap-volume-keys", &prop, &psize) == kSuccess && psize == 4 &&
+		    *(const uint32_t *)prop) {
+			keys_swap_vol = true;
+		}
+	}
 	keys_core = ml_io_map(KEYS_CORE_PA, 0x2000);
 	keys_cnfg = ml_io_map(KEYS_CNFG_PA, 0x1000);

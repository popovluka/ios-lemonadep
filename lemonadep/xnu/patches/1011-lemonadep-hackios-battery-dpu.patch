--- /dev/null
+++ b/bsd/dev/redwood_dpu.c
@@ -0,0 +1,642 @@
+/*
+ * The display engine of the OnePlus 9 Pro (lemonadep, SM8350: Qualcomm's "DPU" 7.0), as the boot
+ * loader leaves it: sending the framebuffer at 0xe4d00000 to the panel, a command-mode panel with
+ * a tearing-effect line (gpio82), over DSI0. Only with board=lemonadep (xnuloader says it).
+ *
+ * Frames without tearing (MiniIOMobileFramebuffer.cpp): the engine sends the framebuffer to the
+ * panel 120 times a second by itself (autorefresh, on every tearing-effect pulse), 2.8 ms a
+ * transfer; a frame written into that memory while a transfer reads it reaches the panel half old,
+ * half new. So frames are drawn into a second picture the engine is not reading and the two source
+ * pipes are pointed at it with a flush, which the engine takes at the start of a transfer, never
+ * in the middle of one (redwood_dpu_flip(), redwood_dpu_flipped()). Before a kernel goes back to
+ * the loader, or panics, the pipes are pointed at the boot loader's framebuffer again
+ * (redwood_dpu_restore()): that is the memory the text console and the loader draw into.
+ * Boot-arg dpu_flip=0: none of this, frames are written into the framebuffer as before.
+ *
+ * Boot-arg dpu_probe=1: say how it is set up -- which source pipe reads the framebuffer, which
+ * control path sends it, whether the engine sends frames by itself ("autorefresh") and whether it
+ * waits for the panel's tearing-effect signal -- and watch its frame counters for a second. Reads
+ * only, after the two clocks without which a register of the display block hangs the bus (seen on
+ * this phone, 22 October): the display clock controller's bus clock in GCC, and the bus clock of
+ * the display block's registers; each is turned on if it is off, nothing else is written.
+ *
+ * The panel's brightness (redwood_dpu_backlight(), for MiniIOMobileFramebuffer.cpp's backlight;
+ * boot-arg backlight=1): the DCS command 0x51 to the panel through DSI0. See below.
+ *
+ * Addresses: the vendor's device tree (lahaina-sde-common.dtsi: mdp_phys 0xae00000, the blocks'
+ * offsets) and Linux's catalog for this SoC (drivers/gpu/drm/msm/disp/dpu1/catalog/
+ * dpu_7_0_sm8350.h: the same offsets from the engine at 0xae01000); register layouts from Linux's
+ * dpu_hw_{sspp,ctl,intf,lm}.c; clocks from the vendor's dispcc-lahaina.c and gcc-lahaina.c.
+ */
+#include <kern/clock.h>
+#include <kern/locks.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+#include <sys/systm.h>
+#include <console/video_console.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern void loader_log_putc(char c);
+extern void MiniIOMobileFramebufferBacklight(void);    /* iokit/Kernel/MiniIOMobileFramebuffer.cpp: iOS's backlight service */
+
+void redwood_dpu_init(void);
+bool redwood_dpu_ready(void);
+void redwood_dpu_flip(uint64_t phys);
+bool redwood_dpu_flipped(void);
+void redwood_dpu_restore(void);
+void redwood_dpu_say(const char *line);
+bool redwood_dpu_backlight_ready(void);
+int redwood_dpu_backlight(uint32_t level);
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[400];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	return printf("%s", line);
+}
+#define printf say
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static inline void
+wr(vm_offset_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+}
+
+/* ---- the clocks in front of the registers ------------------------------------------------------- */
+
+#define GCC_DISP_PAGE_PHYS      0x00127000UL    /* GCC 0x100000: its page of display clocks */
+#define GCC_DISP_AHB_CBCR       0x004           /* (0x127004) gcc_disp_ahb_clk: the display clock controller's bus */
+#define DISPCC_PHYS             0x0af00000UL
+#define DISPCC_SIZE             0x10000UL
+#define DISPCC_MDSS_MDP_CBCR    0x200c
+#define DISPCC_MDSS_VSYNC_CBCR  0x2024
+#define DISPCC_MDSS_AHB_CBCR    0x207c          /* disp_cc_mdss_ahb_clk: the bus of the display block's registers */
+#define DISPCC_MDSS_GDSCR       0x3000          /* disp_cc_mdss_core_gdsc (dt: gdsc_base 0xaf03000) */
+#define CBCR_ENABLE             (1u << 0)
+#define CBCR_OFF                (1u << 31)
+#define GDSC_POWER_ON           (1u << 31)
+
+/* ---- the display block ------------------------------------------------------------------------- */
+
+#define MDSS_PHYS               0x0ae00000UL
+#define MDSS_SIZE               0x90000UL
+#define MDSS_HW_VERSION         0x0
+#define DPU                     0x1000          /* the engine; Linux's catalog counts from here */
+#define CTL(n)                  (DPU + 0x15000 + 0x1000 * (n))
+#define CTL_LAYER_LM0           0x000
+#define CTL_TOP                 0x014
+#define CTL_FLUSH               0x018
+#define CTL_START               0x01c
+#define CTL_MERGE_3D_ACTIVE     0x0e4
+#define CTL_DSC_ACTIVE          0x0e8
+#define CTL_INTF_ACTIVE         0x0f4
+#define CTL_FETCH_PIPE_ACTIVE   0x0fc
+#define CTL_INTF_FLUSH          0x110
+#define CTLS                    6
+#define SSPPS                   8
+static const struct {
+	const char *name;
+	uint32_t base, flush;           /* (base from DPU; the pipe's bit in CTL_FLUSH) */
+} sspp[SSPPS] = {
+	{ "vig0", 0x4000, 1u << 0 }, { "vig1", 0x6000, 1u << 1 }, { "vig2", 0x8000, 1u << 2 }, { "vig3", 0xa000, 1u << 18 },
+	{ "dma0", 0x24000, 1u << 11 }, { "dma1", 0x26000, 1u << 12 }, { "dma2", 0x28000, 1u << 24 }, { "dma3", 0x2a000, 1u << 25 },
+};
+#define SSPP_SRC_SIZE           0x00
+#define SSPP_SRC_XY             0x08
+#define SSPP_OUT_SIZE           0x0c
+#define SSPP_OUT_XY             0x10
+#define SSPP_SRC0_ADDR          0x14
+#define SSPP_SRC_YSTRIDE0       0x24
+#define SSPP_SRC_FORMAT         0x30
+#define SSPP_SRC_OP_MODE        0x38
+#define SSPP_SRC_ADDR_SW_STATUS 0x70
+#define LM(n)                   (DPU + 0x44000 + 0x1000 * (n))
+#define LM_OP_MODE              0x00
+#define LM_OUT_SIZE             0x04
+#define LMS                     6
+#define INTF(n)                 (DPU + 0x34000 + 0x1000 * (n))  /* 1: DSI0, 2: DSI1 */
+#define INTF_TIMING_ENGINE_EN   0x000
+#define INTF_CONFIG             0x004
+#define INTF_CONFIG2            0x060
+#define INTF_FRAME_COUNT        0x0ac
+#define INTF_LINE_COUNT         0x0b0
+#define INTF_STATUS             0x26c
+#define INTF_TEAR_MDP_VSYNC_SEL 0x280
+#define INTF_TEAR_TEAR_CHECK_EN 0x284
+#define INTF_TEAR_SYNC_CONFIG_VSYNC 0x288
+#define INTF_TEAR_SYNC_CONFIG_HEIGHT 0x28c
+#define INTF_TEAR_SYNC_WRCOUNT  0x290
+#define INTF_TEAR_VSYNC_INIT_VAL 0x294
+#define INTF_TEAR_INT_COUNT_VAL 0x298           /* the panel's read pointer: frame << 16 | line */
+#define INTF_TEAR_SYNC_THRESH   0x29c
+#define INTF_TEAR_START_POS     0x2a0
+#define INTF_TEAR_RD_PTR_IRQ    0x2a4
+#define INTF_TEAR_WR_PTR_IRQ    0x2a8
+#define INTF_TEAR_OUT_LINE_COUNT 0x2ac
+#define INTF_TEAR_LINE_COUNT    0x2b0           /* the engine's write pointer: the line being sent */
+#define INTF_TEAR_AUTOREFRESH_CONFIG 0x2b4      /* bit 31 on, [15:0] every so many tearing-effect pulses */
+
+static vm_offset_t gcc_disp, dispcc, mdss;
+
+/*
+ * The two clocks in front of the display block's registers, as Linux has them on for as long as
+ * it drives the display: true when the registers can be read. The first is gated by the hardware
+ * while unused (hwcg bit 1: it reads "off" until it is talked to), so only its enable is looked at.
+ */
+static bool
+registers_reachable(void)
+{
+	uint32_t ahb;
+
+	if (gcc_disp == 0) {
+		gcc_disp = ml_io_map(GCC_DISP_PAGE_PHYS, 0x1000);
+		dispcc = ml_io_map(DISPCC_PHYS, DISPCC_SIZE);
+		mdss = ml_io_map(MDSS_PHYS, MDSS_SIZE);
+	}
+	if (!(rd(gcc_disp + GCC_DISP_AHB_CBCR) & CBCR_ENABLE)) {
+		printf("dpu: gcc disp_ahb (0x127004) = %#x: turning it on\n", rd(gcc_disp + GCC_DISP_AHB_CBCR));
+		wr(gcc_disp + GCC_DISP_AHB_CBCR, rd(gcc_disp + GCC_DISP_AHB_CBCR) | CBCR_ENABLE);
+		delay(10 * 1000);
+	}
+	if (!(rd(dispcc + DISPCC_MDSS_GDSCR) & GDSC_POWER_ON)) {
+		printf("dpu: the display block has no power (dispcc mdss_gdscr %#x): not touched\n", rd(dispcc + DISPCC_MDSS_GDSCR));
+		return false;
+	}
+	ahb = rd(dispcc + DISPCC_MDSS_AHB_CBCR);
+	if (ahb & CBCR_OFF) {
+		printf("dpu: dispcc mdss_ahb (0xaf0207c) = %#x: turning it on\n", ahb);
+		wr(dispcc + DISPCC_MDSS_AHB_CBCR, ahb | CBCR_ENABLE);
+		for (int i = 0; i < 100 && (rd(dispcc + DISPCC_MDSS_AHB_CBCR) & CBCR_OFF); i++) {
+			delay(100);
+		}
+		ahb = rd(dispcc + DISPCC_MDSS_AHB_CBCR);
+		if (ahb & CBCR_OFF) {
+			printf("dpu: the display block's register clock stays off (%#x): not touched\n", ahb);
+			return false;
+		}
+	}
+	return true;
+}
+
+static void
+probe(void)
+{
+	uint32_t counts[2][2][2];
+	uint64_t times[2];
+
+	printf("dpu: clocks: gcc disp_ahb %#x; dispcc mdss_gdscr %#x, mdss_ahb %#x, mdss_mdp %#x, mdss_vsync %#x\n",
+	    rd(gcc_disp + GCC_DISP_AHB_CBCR), rd(dispcc + DISPCC_MDSS_GDSCR), rd(dispcc + DISPCC_MDSS_AHB_CBCR),
+	    rd(dispcc + DISPCC_MDSS_MDP_CBCR), rd(dispcc + DISPCC_MDSS_VSYNC_CBCR));
+	printf("dpu: mdss hw version %#x\n", rd(mdss + MDSS_HW_VERSION));
+	for (unsigned n = 0; n < CTLS; n++) {
+		vm_offset_t c = mdss + CTL(n);
+
+		printf("dpu: ctl%u: layer(lm0) %#x top %#x flush %#x start %#x intf_active %#x fetch_pipe_active %#x dsc_active %#x "
+		    "merge_3d_active %#x intf_flush %#x\n", n, rd(c + CTL_LAYER_LM0), rd(c + CTL_TOP), rd(c + CTL_FLUSH),
+		    rd(c + CTL_START), rd(c + CTL_INTF_ACTIVE), rd(c + CTL_FETCH_PIPE_ACTIVE), rd(c + CTL_DSC_ACTIVE),
+		    rd(c + CTL_MERGE_3D_ACTIVE), rd(c + CTL_INTF_FLUSH));
+	}
+	for (unsigned i = 0; i < SSPPS; i++) {
+		vm_offset_t s = mdss + DPU + sspp[i].base;
+
+		printf("dpu: %s: src_size %#x src_xy %#x out_size %#x out_xy %#x src0_addr %#x ystride0 %#x format %#x op_mode %#x "
+		    "addr_sw_status %#x\n", sspp[i].name, rd(s + SSPP_SRC_SIZE), rd(s + SSPP_SRC_XY), rd(s + SSPP_OUT_SIZE),
+		    rd(s + SSPP_OUT_XY), rd(s + SSPP_SRC0_ADDR), rd(s + SSPP_SRC_YSTRIDE0), rd(s + SSPP_SRC_FORMAT),
+		    rd(s + SSPP_SRC_OP_MODE), rd(s + SSPP_SRC_ADDR_SW_STATUS));
+	}
+	for (unsigned n = 0; n < LMS; n++) {
+		printf("dpu: lm%u: op_mode %#x out_size %#x\n", n, rd(mdss + LM(n) + LM_OP_MODE), rd(mdss + LM(n) + LM_OUT_SIZE));
+	}
+	for (unsigned n = 1; n <= 2; n++) {
+		vm_offset_t f = mdss + INTF(n);
+
+		printf("dpu: intf%u: timing_engine_en %#x config %#x config2 %#x frame_count %#x line_count %#x status %#x\n", n,
+		    rd(f + INTF_TIMING_ENGINE_EN), rd(f + INTF_CONFIG), rd(f + INTF_CONFIG2), rd(f + INTF_FRAME_COUNT),
+		    rd(f + INTF_LINE_COUNT), rd(f + INTF_STATUS));
+		printf("dpu: intf%u tear: vsync_sel %#x check_en %#x sync_config_vsync %#x sync_config_height %#x wrcount %#x "
+		    "vsync_init %#x int_count %#x thresh %#x start_pos %#x rd_ptr_irq %#x wr_ptr_irq %#x out_line_count %#x "
+		    "line_count %#x autorefresh %#x\n", n, rd(f + INTF_TEAR_MDP_VSYNC_SEL), rd(f + INTF_TEAR_TEAR_CHECK_EN),
+		    rd(f + INTF_TEAR_SYNC_CONFIG_VSYNC), rd(f + INTF_TEAR_SYNC_CONFIG_HEIGHT), rd(f + INTF_TEAR_SYNC_WRCOUNT),
+		    rd(f + INTF_TEAR_VSYNC_INIT_VAL), rd(f + INTF_TEAR_INT_COUNT_VAL), rd(f + INTF_TEAR_SYNC_THRESH),
+		    rd(f + INTF_TEAR_START_POS), rd(f + INTF_TEAR_RD_PTR_IRQ), rd(f + INTF_TEAR_WR_PTR_IRQ),
+		    rd(f + INTF_TEAR_OUT_LINE_COUNT), rd(f + INTF_TEAR_LINE_COUNT), rd(f + INTF_TEAR_AUTOREFRESH_CONFIG));
+	}
+	/* how fast the counters of the interface the panel is on go: twice, a second apart */
+	for (int i = 0; i < 2; i++) {
+		for (unsigned n = 1; n <= 2; n++) {
+			counts[i][n - 1][0] = rd(mdss + INTF(n) + INTF_TEAR_INT_COUNT_VAL);
+			counts[i][n - 1][1] = rd(mdss + INTF(n) + INTF_FRAME_COUNT);
+		}
+		absolutetime_to_nanoseconds(mach_absolute_time(), &times[i]);
+		if (i == 0) {
+			delay(1000 * 1000);
+		}
+	}
+	for (unsigned n = 1; n <= 2; n++) {
+		printf("dpu: intf%u in %llu ms: the panel's read pointer from frame %u line %u to frame %u line %u; the interface's "
+		    "frames from %u to %u\n", n, (times[1] - times[0]) / 1000000, counts[0][n - 1][0] >> 16, counts[0][n - 1][0] & 0xffff,
+		    counts[1][n - 1][0] >> 16, counts[1][n - 1][0] & 0xffff, counts[0][n - 1][1], counts[1][n - 1][1]);
+	}
+	/* where the engine's write pointer is, eight times a millisecond and a bit apart: a transfer, or none */
+	for (int i = 0; i < 8; i++) {
+		printf("dpu: intf1 write pointer at line %u, read pointer %#x\n", rd(mdss + INTF(1) + INTF_TEAR_LINE_COUNT) & 0xffff,
+		    rd(mdss + INTF(1) + INTF_TEAR_INT_COUNT_VAL));
+		delay(1300);
+	}
+}
+
+/* ---- flips ------------------------------------------------------------------------------------- */
+
+/* The framebuffer the boot loader left: vig0 reads its left half, vig1 its right, from the same address. */
+#define FB_PHYS                 0xe4d00000UL
+#define FLIP_PIPES              (1u << 0 | 1u << 1)     /* CTL_FLUSH bits of vig0 and vig1 */
+#define AUTOREFRESH_ON          (1u << 31)
+
+static bool flips_ok;                   /* redwood_dpu_ready() found the engine as described above */
+static bool flipped_away;               /* the pipes have been pointed somewhere else than FB_PHYS */
+
+/*
+ * Is the engine as this file expects it -- the two pipes reading the boot loader's framebuffer for
+ * control path 0, sending frames by itself on the tearing-effect signal? Said once, either way.
+ */
+bool
+redwood_dpu_ready(void)
+{
+	static bool asked;
+	char board[32];
+	uint32_t want = 1, fetch, autorefresh, tear;
+
+	if (asked) {
+		return flips_ok;
+	}
+	asked = true;
+	if (!PE_parse_boot_arg_str("board", board, sizeof(board)) || strcmp(board, "lemonadep") != 0) {
+		return false;
+	}
+	if (PE_parse_boot_argn("dpu_flip", &want, sizeof(want)) && !want) {
+		printf("dpu: dpu_flip=0: frames go straight into the framebuffer\n");
+		return false;
+	}
+	if (!registers_reachable()) {
+		return false;
+	}
+	fetch = rd(mdss + CTL(0) + CTL_FETCH_PIPE_ACTIVE);
+	autorefresh = rd(mdss + INTF(1) + INTF_TEAR_AUTOREFRESH_CONFIG);
+	tear = rd(mdss + INTF(1) + INTF_TEAR_TEAR_CHECK_EN);
+	if (rd(mdss + DPU + sspp[0].base + SSPP_SRC0_ADDR) != FB_PHYS || rd(mdss + DPU + sspp[1].base + SSPP_SRC0_ADDR) != FB_PHYS ||
+	    (fetch & 0x30000) != 0x30000 || !(autorefresh & AUTOREFRESH_ON) || !(tear & 1)) {
+		printf("dpu: not as expected (vig0 %#x, vig1 %#x, ctl0 fetch_pipe_active %#x, intf1 autorefresh %#x, tear check %#x): "
+		    "no flips\n", rd(mdss + DPU + sspp[0].base + SSPP_SRC0_ADDR), rd(mdss + DPU + sspp[1].base + SSPP_SRC0_ADDR),
+		    fetch, autorefresh, tear);
+		return false;
+	}
+	printf("dpu: vig0 and vig1 read the framebuffer for ctl0, which sends a frame on every tearing-effect pulse "
+	    "(autorefresh %#x): frames can go to the panel by flips\n", autorefresh);
+	flips_ok = true;
+	return true;
+}
+
+/* Both pipes to read from `phys` (one picture: vig1's source rectangle is its right half), from the next transfer on. */
+void
+redwood_dpu_flip(uint64_t phys)
+{
+	if (!flips_ok) {
+		return;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");       /* the picture in memory before the engine is told about it */
+	wr(mdss + DPU + sspp[0].base + SSPP_SRC0_ADDR, (uint32_t)phys);
+	wr(mdss + DPU + sspp[1].base + SSPP_SRC0_ADDR, (uint32_t)phys);
+	wr(mdss + CTL(0) + CTL_FLUSH, FLIP_PIPES);
+	flipped_away = phys != FB_PHYS;
+}
+
+/* Has the engine taken the last flip? It clears the flush bits at the start of the transfer that reads the new picture. */
+bool
+redwood_dpu_flipped(void)
+{
+	return !flips_ok || !(rd(mdss + CTL(0) + CTL_FLUSH) & FLIP_PIPES);
+}
+
+/* A line of the framebuffer driver's about flips, where the loader keeps it (the kernel's own log is a ring). */
+void
+redwood_dpu_say(const char *line)
+{
+	printf("%s", line);
+}
+
+/* ---- the panel's brightness -------------------------------------------------------------------- */
+
+/*
+ * The panel (Samsung AMB670YF01, on DSI0) takes its brightness as the DCS command 0x51 with a
+ * 12-bit level, high byte first: 1..0x7ff, and above that its high-brightness range, which is not
+ * used here (the vendor's dtbo: bl_ctrl_dcs, bl-min-level 1, bl-normal-max-level 0x7ff,
+ * brightness-default-level 0x190, where the boot loader leaves it).
+ *
+ * DSI0's command engine sends it while the display engine goes on sending frames: the controller
+ * puts a command packet between the packets of a frame if it must (the interleave setting in
+ * DSI_COMMAND_MODE_MDP_CTRL), and here it is started when no frame is being sent (DSI_STATUS),
+ * if that comes within 20 ms. The packet goes through the FIFO of the controller's test-pattern
+ * block, as the vendor's dsi_ctrl_hw_cmn_kickoff_fifo_command() does it: nothing in memory for the
+ * controller to fetch, so nothing the display's SMMU has to let it read. In high-speed mode, as
+ * commands go while the display is on. Registers: the vendor's dsi_ctrl_reg.h (techpack/display/
+ * msm/dsi); the packet as its dsi_ctrl_copy_and_pad_cmd() lays one out: word count, data type,
+ * flags (last packet, long packet), the bytes, 0xff up to a whole word.
+ *
+ * Boot-arg backlight=1 (MiniIOMobileFramebuffer.cpp gives iOS a backlight then). Boot-arg
+ * backlight_test=1: at boot, the panel dim (0x40), bright (0x7ff), then as it was, 1.5 s each.
+ */
+#define DSI0_PHYS                       0x0ae94000UL
+#define DSI_SIZE                        0x400
+#define DSI_HW_VERSION                  0x000
+#define DSI_CTRL                        0x004
+#define DSI_STATUS                      0x008
+#define DSI_COMMAND_MODE_DMA_CTRL       0x03c
+#define DSI_COMMAND_MODE_MDP_CTRL       0x040
+#define DSI_DMA_CMD_LENGTH              0x04c
+#define DSI_ACK_ERR_STATUS              0x068
+#define DSI_TRIG_CTRL                   0x084
+#define DSI_CMD_MODE_DMA_SW_TRIGGER     0x090
+#define DSI_LANE_STATUS                 0x0a8
+#define DSI_INT_CTRL                    0x110
+#define DSI_CLK_CTRL                    0x11c
+#define DSI_TEST_PATTERN_GEN_CTRL       0x15c
+#define DSI_TEST_PATTERN_GEN_CMD_DMA_INIT_VAL 0x17c
+#define DSI_TPG_DMA_FIFO_STATUS         0x1dc
+#define DSI_TPG_DMA_FIFO_RESET          0x1ec
+#define DSI_CTRL_ENABLE                 (1u << 0)
+#define DSI_CTRL_CMD_MODE               (1u << 2)
+#define DSI_STATUS_DMA_BUSY             (1u << 1)
+#define DSI_STATUS_MDP_BUSY             (1u << 2)
+#define DMA_CTRL_LOW_POWER              (1u << 26)
+#define DMA_CTRL_EMBEDDED               (1u << 28)
+#define DMA_CTRL_BROADCAST              (3u << 30)
+#define TRIG_DMA                        0xfu            /* DSI_TRIG_CTRL: what starts a command: 4, the software */
+#define TRIG_DMA_SW                     0x4u
+#define INT_CMD_DMA_DONE                (1u << 0)
+#define INT_ERROR                       (1u << 24)
+#define TPG_CMD_DMA_FIFO                (1u << 1 | 1u << 2 | 3u << 16)  /* the command engine takes its packet from the FIFO */
+#define DCS_SET_DISPLAY_BRIGHTNESS      0x51
+#define BACKLIGHT_MAX                   0x7ff
+#define BACKLIGHT_BOOT                  0x190
+
+static vm_offset_t dsi;
+static bool backlight_ok;
+static uint32_t backlight_level = BACKLIGHT_BOOT;       /* what the panel was last told */
+static uint32_t backlight_sent, backlight_failed;
+static uint32_t backlight_lowest = BACKLIGHT_MAX, backlight_highest;     /* of the levels sent */
+static LCK_GRP_DECLARE(backlight_lock_group, "redwood-backlight");
+static LCK_MTX_DECLARE(backlight_lock, &backlight_lock_group);
+
+static void
+dsi_fifo_reset(void)
+{
+	wr(dsi + DSI_TEST_PATTERN_GEN_CTRL, 0);
+	wr(dsi + DSI_TPG_DMA_FIFO_RESET, 1);
+	delay(1);
+	wr(dsi + DSI_TPG_DMA_FIFO_RESET, 0);
+}
+
+/* 0x51 with `level` to the panel; 0 once the controller says the packet is out, else what went wrong. */
+static int
+dcs_brightness(uint32_t level, uint32_t *waited_us)
+{
+	uint64_t began = mach_absolute_time(), now;
+	unsigned i;
+	int done;
+
+	for (i = 0; i < 400 && (rd(dsi + DSI_STATUS) & (DSI_STATUS_MDP_BUSY | DSI_STATUS_DMA_BUSY)); i++) {
+		delay(50);
+	}
+	if (rd(dsi + DSI_STATUS) & DSI_STATUS_DMA_BUSY) {
+		return EBUSY;                   /* the last command is still going: not two at once */
+	}
+	dsi_fifo_reset();
+	wr(dsi + DSI_INT_CTRL, (rd(dsi + DSI_INT_CTRL) & ~INT_ERROR) | INT_CMD_DMA_DONE);       /* an old "done" away */
+	wr(dsi + DSI_TEST_PATTERN_GEN_CTRL, TPG_CMD_DMA_FIFO);
+	wr(dsi + DSI_TEST_PATTERN_GEN_CMD_DMA_INIT_VAL, 0xc0u << 24 | 0x39u << 16 | 3u);        /* 03 00 39 c0: 3 bytes, DCS long write, last */
+	wr(dsi + DSI_TEST_PATTERN_GEN_CMD_DMA_INIT_VAL, 0xffu << 24 | (level & 0xff) << 16 | (level >> 8 & 0xff) << 8 |
+	    DCS_SET_DISPLAY_BRIGHTNESS);
+	wr(dsi + DSI_COMMAND_MODE_DMA_CTRL, (rd(dsi + DSI_COMMAND_MODE_DMA_CTRL) & ~(DMA_CTRL_LOW_POWER | DMA_CTRL_BROADCAST)) |
+	    DMA_CTRL_EMBEDDED);
+	wr(dsi + DSI_DMA_CMD_LENGTH, 8);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wr(dsi + DSI_CMD_MODE_DMA_SW_TRIGGER, 1);
+	for (i = 0; i < 2000 && !(rd(dsi + DSI_INT_CTRL) & INT_CMD_DMA_DONE); i++) {
+		delay(10);
+	}
+	done = rd(dsi + DSI_INT_CTRL) & INT_CMD_DMA_DONE;
+	if (done) {
+		wr(dsi + DSI_INT_CTRL, (rd(dsi + DSI_INT_CTRL) & ~INT_ERROR) | INT_CMD_DMA_DONE);
+	}
+	dsi_fifo_reset();                       /* as the vendor leaves the FIFO after a command */
+	now = mach_absolute_time();
+	if (waited_us != NULL) {
+		uint64_t ns;
+
+		absolutetime_to_nanoseconds(now - began, &ns);
+		*waited_us = (uint32_t)(ns / 1000);
+	}
+	return done ? 0 : ETIMEDOUT;
+}
+
+/* Can the panel's brightness be set (board=lemonadep, backlight=1, DSI0 sending frames in command mode)? */
+bool
+redwood_dpu_backlight_ready(void)
+{
+	return backlight_ok;
+}
+
+/* The panel's brightness: 0 (dark) .. 0x7ff, as DCS 0x51 has it. 0, or why it was not set. */
+int
+redwood_dpu_backlight(uint32_t level)
+{
+	uint32_t waited = 0;
+	int error;
+
+	if (!backlight_ok) {
+		return ENXIO;
+	}
+	if (level > BACKLIGHT_MAX) {
+		level = BACKLIGHT_MAX;
+	}
+	lck_mtx_lock(&backlight_lock);
+	if (level == backlight_level && backlight_sent != 0) {
+		lck_mtx_unlock(&backlight_lock);
+		return 0;
+	}
+	error = dcs_brightness(level, &waited);
+	if (error == 0) {
+		backlight_sent++;
+		backlight_lowest = level < backlight_lowest ? level : backlight_lowest;
+		backlight_highest = level > backlight_highest ? level : backlight_highest;
+		if (backlight_sent <= 8 || backlight_sent % 50 == 0) {
+			printf("dpu: backlight %#x -> %#x (%u us; %u sent, %u failed)\n", backlight_level, level, waited,
+			    backlight_sent, backlight_failed);
+		}
+		backlight_level = level;
+	} else if (backlight_failed++ < 8) {
+		printf("dpu: backlight %#x not sent (error %d after %u us): dsi status %#x int_ctrl %#x ack_err %#x lane_status %#x "
+		    "tpg_fifo %#x\n", level, error, waited, rd(dsi + DSI_STATUS), rd(dsi + DSI_INT_CTRL), rd(dsi + DSI_ACK_ERR_STATUS),
+		    rd(dsi + DSI_LANE_STATUS), rd(dsi + DSI_TPG_DMA_FIFO_STATUS));
+	}
+	lck_mtx_unlock(&backlight_lock);
+	return error;
+}
+
+static void
+dsi_registers(const char *when)
+{
+	printf("dpu: dsi0 %s: hw_version %#x ctrl %#x status %#x dma_ctrl %#x mdp_ctrl %#x trig_ctrl %#x int_ctrl %#x clk_ctrl %#x "
+	    "lane_status %#x ack_err %#x tpg_ctrl %#x tpg_fifo %#x\n", when, rd(dsi + DSI_HW_VERSION), rd(dsi + DSI_CTRL),
+	    rd(dsi + DSI_STATUS), rd(dsi + DSI_COMMAND_MODE_DMA_CTRL), rd(dsi + DSI_COMMAND_MODE_MDP_CTRL), rd(dsi + DSI_TRIG_CTRL),
+	    rd(dsi + DSI_INT_CTRL), rd(dsi + DSI_CLK_CTRL), rd(dsi + DSI_LANE_STATUS), rd(dsi + DSI_ACK_ERR_STATUS),
+	    rd(dsi + DSI_TEST_PATTERN_GEN_CTRL), rd(dsi + DSI_TPG_DMA_FIFO_STATUS));
+}
+
+static void
+backlight_init(void)
+{
+	uint32_t want = 0, ctrl, trig;
+	static const uint32_t test[] = { 0x40, BACKLIGHT_MAX, BACKLIGHT_BOOT };
+
+	if (!PE_parse_boot_argn("backlight", &want, sizeof(want)) || !want || !registers_reachable()) {
+		return;
+	}
+	dsi = ml_io_map(DSI0_PHYS, DSI_SIZE);
+	dsi_registers("as found");
+	ctrl = rd(dsi + DSI_CTRL);
+	if ((ctrl & (DSI_CTRL_ENABLE | DSI_CTRL_CMD_MODE)) != (DSI_CTRL_ENABLE | DSI_CTRL_CMD_MODE)) {
+		printf("dpu: dsi0 is not on in command mode (ctrl %#x): no backlight\n", ctrl);
+		return;
+	}
+	trig = rd(dsi + DSI_TRIG_CTRL);
+	if ((trig & TRIG_DMA) != TRIG_DMA_SW) {
+		printf("dpu: dsi0 commands start on %#x, not by software: set\n", trig & TRIG_DMA);
+		wr(dsi + DSI_TRIG_CTRL, (trig & ~TRIG_DMA) | TRIG_DMA_SW);
+	}
+	backlight_ok = true;
+	printf("dpu: the panel's brightness goes by DCS 0x51 through dsi0 (from %#x, the boot loader's)\n", backlight_level);
+	if (PE_parse_boot_argn("backlight_test", &want, sizeof(want)) && want) {
+		for (unsigned i = 0; i < sizeof(test) / sizeof(test[0]); i++) {
+			printf("dpu: backlight_test: %#x\n", test[i]);
+			redwood_dpu_backlight(test[i]);
+			delay(1500 * 1000);
+		}
+		dsi_registers("after the test");
+	}
+	MiniIOMobileFramebufferBacklight();
+}
+
+/* ---- notes on the panel at the end of a run ------------------------------------------------------- */
+
+/*
+ * A few lines that other drivers keep up to date (redwood_dpu_note()) and that are drawn on the panel
+ * when the kernel goes back to the loader: what a run says about itself when its log cannot come
+ * back over USB (a cable pulled during a run leaves the loader without USB: 24 October), read off
+ * the panel instead. Drawn with the text console's font, three times its size, over the picture.
+ */
+#define NOTE_LINES              8
+#define NOTE_CHARS              44
+#define NOTE_SCALE              3
+#define NOTE_TOP                160
+
+extern struct vc_info vinfo;
+extern unsigned char iso_font[];
+static char notes[NOTE_LINES][NOTE_CHARS + 1];
+
+void
+redwood_dpu_note(unsigned line, const char *text)
+{
+	if (line < NOTE_LINES) {
+		strlcpy(notes[line], text, sizeof(notes[line]));
+	}
+}
+
+static void
+draw_notes(void)
+{
+	uint8_t *fb = (uint8_t *)vinfo.v_baseaddr;
+
+	if (fb == NULL || vinfo.v_depth != 32) {
+		return;
+	}
+	for (unsigned line = 0; line < NOTE_LINES; line++) {
+		uint32_t y0 = NOTE_TOP + line * 16 * NOTE_SCALE;
+		size_t length = strlen(notes[line]);
+
+		if (length == 0 || y0 + 16 * NOTE_SCALE > vinfo.v_height) {
+			continue;
+		}
+		for (uint32_t y = y0; y < y0 + 16 * NOTE_SCALE; y++) {
+			uint32_t *row = (uint32_t *)(fb + (size_t)y * vinfo.v_rowbytes);
+			const uint32_t glyph_row = (y - y0) / NOTE_SCALE;
+
+			for (uint32_t x = 0; x < vinfo.v_width; x++) {
+				uint32_t dot = x / NOTE_SCALE;         /* in the font's pixels, two of margin first */
+				bool lit = false;
+
+				if (dot >= 2 && (dot - 2) / 8 < length) {
+					unsigned char c = (unsigned char)notes[line][(dot - 2) / 8];
+
+					lit = (iso_font[c * 16 + glyph_row] & (1u << ((dot - 2) % 8))) != 0;
+				}
+				row[x] = lit ? 0xffffffffu : 0xff000000u;
+			}
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+/* The boot loader's framebuffer on the panel again: for the text console, a panic, the loader. */
+void
+redwood_dpu_restore(void)
+{
+	if (flips_ok && flipped_away) {
+		redwood_dpu_flip(FB_PHYS);
+	}
+	/* and the boot loader's brightness (without the lock: this may be a panic, every other processor stopped) */
+	if (backlight_ok) {
+		printf("dpu: backlight: %u levels sent, %u not, the last %#x (%#x..%#x seen)\n", backlight_sent, backlight_failed,
+		    backlight_level, backlight_lowest, backlight_highest);
+	}
+	if (backlight_ok && backlight_level != BACKLIGHT_BOOT && dcs_brightness(BACKLIGHT_BOOT, NULL) == 0) {
+		backlight_level = BACKLIGHT_BOOT;
+	}
+	draw_notes();
+}
+
+void
+redwood_dpu_init(void)
+{
+	char board[32];
+	uint32_t want = 0;
+
+	if (!PE_parse_boot_arg_str("board", board, sizeof(board)) || strcmp(board, "lemonadep") != 0) {
+		return;
+	}
+	if (PE_parse_boot_argn("dpu_probe", &want, sizeof(want)) && want) {
+		printf("dpu: probe: the display engine as the boot loader left it\n");
+		if (registers_reachable()) {
+			probe();
+		}
+	}
+	backlight_init();
+}

--- /dev/null
+++ b/bsd/dev/redwood_gauge.c
@@ -0,0 +1,502 @@
+/*
+ * The battery of the OnePlus 9 Pro (lemonadep, SM8350): two cells in series and a TI BQ28Z610 fuel
+ * gauge in front of them, on an I2C bus of the application processor. Only with board=lemonadep
+ * and boot-arg battery=1 (redwood_battery_init() starts this instead of reading the loader's UEFI
+ * cache). The device tree also puts an MPS MP2650 charger on another bus; on this phone nothing
+ * answers at its address (seen 23 October, battery_scan=1: of that bus only the wireless charging's
+ * pump, an HL7227 at 0x51). Wired charging is the audio DSP's battery manager's on this SoC
+ * (redwood_adsp.c on the redwood), and without it the battery takes no charge: on USB the gauge
+ * measured about 0 mA with the phone lightly loaded (23 October), and 300 to 500 mA out of the
+ * battery with the GPU and every core at speed (24 October): the port gives what it can, the
+ * battery the rest. That current is how "a charger is there" is told here, for want of a status
+ * to read (see below), so a phone under load on USB counts as running from its battery.
+ *
+ * From the phone's device tree (dtbo overlay "lemonadep"):
+ *   gauge    qupv3_se2_i2c, bq27541-battery@55 with qcom,batt_bq28z610, 100 kHz: gpio12 data, gpio13 clock
+ *   charger  qupv3_se0_i2c, mp2650-charger@5c: gpio4 data, gpio5 clock
+ * Both serial engines are GSI-only (lahaina-qupv3.dtsi: dmas = <&gpi_dma0 ...>), as the touch
+ * screen's is, so both buses are driven by hand as redwood_synaptics.c drives its own: open drain,
+ * a line pulled low by making its pin an output at 0, let go by making it an input with its pull-up.
+ *
+ * NOTHING IS WRITTEN TO EITHER CHIP: every access is a register read (the register's address
+ * written, then a repeated start and the read). The gauge's standard commands and the charger's
+ * status and ADC registers are OnePlus's drivers' (drivers/power/oplus/gauge_ic/oplus_bq27541.[ch],
+ * charger_ic/oplus_mp2650.[ch] in LineageOS android_kernel_oneplus_sm8350). Whatever the charger
+ * does, it does with the settings it has: its own defaults once its watchdog has run out (Android
+ * is not there to kick it), and they are logged once at the start, register for register.
+ *
+ * Every five seconds what the gauge says goes to the power source iOS reads (redwood_battery_report(),
+ * RedwoodBattery.cpp): the state of charge, the voltage of a cell (half the pack's: iOS knows
+ * one-cell phones), the current (positive while charging), the temperature, the charges in mAh, the
+ * cycle count. Charging: the charger's status where it answers; otherwise from the current alone --
+ * more than 20 mA into the battery is charging, less than 50 mA out of it is a phone running from
+ * its USB port (this kernel never draws so little), more is a phone running from its battery.
+ */
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/redwood_input.h>
+#include <sys/systm.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern kern_return_t thread_terminate(thread_t thread);
+extern void loader_log_putc(char c);
+
+void redwood_gauge_start(void);
+
+static int say(const char *format, ...) __printflike(1, 2);
+
+static int
+say(const char *format, ...)
+{
+	char line[400];
+	va_list list;
+
+	va_start(list, format);
+	vsnprintf(line, sizeof(line), format, list);
+	va_end(list);
+	for (const char *c = line; *c != 0; c++) {
+		loader_log_putc(*c);
+	}
+	return printf("%s", line);
+}
+#define printf say
+
+static vm_offset_t tlmm;
+
+static inline uint32_t
+rd(vm_offset_t address)
+{
+	return *(volatile uint32_t *)address;
+}
+
+static inline void
+wr(vm_offset_t address, uint32_t value)
+{
+	*(volatile uint32_t *)address = value;
+}
+
+/* a busy wait, for the buses' half periods */
+static void
+spin_ns(uint32_t ns)
+{
+	uint64_t ticks, deadline;
+
+	nanoseconds_to_absolutetime(ns, &ticks);
+	deadline = mach_absolute_time() + (ticks ? ticks : 1);
+	while (mach_absolute_time() < deadline) {
+	}
+}
+
+/* ---- the two buses, by hand -------------------------------------------------------------------- */
+
+#define TLMM_PHYS               0x0f100000UL
+#define TLMM_SIZE               0x100000UL
+#define GPIO_CFG(n)             (tlmm + 0x1000UL * (n))         /* [1:0] pull, [5:2] function, [8:6] drive, [9] output */
+#define GPIO_IO(n)              (tlmm + 0x1000UL * (n) + 4)     /* bit 0 in, bit 1 out */
+#define CFG_OUTPUT              (1u << 9)
+#define CFG_EGPIO_PRESENT       (1u << 11)      /* (as in redwood_synaptics.c: a pin of the island's is claimed) */
+#define CFG_EGPIO_ENABLE        (1u << 12)
+#define PULL_UP                 3
+#define BUS_MA                  4
+#define HALF_NS                 5000            /* 100 kHz, the gauge's bus speed in the device tree */
+#define STRETCH_US              20000           /* how long a chip may hold the clock low */
+
+struct bus {
+	const char *name;
+	unsigned sda, scl;
+	uint32_t keep_sda, keep_scl;    /* eGPIO bits to keep in the pins' configuration */
+	uint64_t nacks, stretches;
+};
+
+static struct bus gauge_bus = { .name = "gauge", .sda = 12, .scl = 13 };
+static struct bus charger_bus = { .name = "charger", .sda = 4, .scl = 5 };
+
+static void
+line(struct bus *b, unsigned pin, bool low)
+{
+	uint32_t keep = pin == b->sda ? b->keep_sda : b->keep_scl;
+
+	wr(GPIO_CFG(pin), keep | PULL_UP | (BUS_MA / 2 - 1) << 6 | (low ? CFG_OUTPUT : 0));
+}
+
+static bool
+level(unsigned pin)
+{
+	return rd(GPIO_IO(pin)) & 1;
+}
+
+static bool
+scl_release(struct bus *b)
+{
+	line(b, b->scl, false);
+	for (int i = 0; !level(b->scl); i++) {
+		if (i >= STRETCH_US) {
+			b->stretches++;
+			return false;
+		}
+		spin_ns(1000);
+	}
+	return true;
+}
+
+static void
+bus_start(struct bus *b)
+{
+	line(b, b->sda, false);
+	scl_release(b);
+	spin_ns(HALF_NS);
+	line(b, b->sda, true);
+	spin_ns(HALF_NS);
+	line(b, b->scl, true);
+	spin_ns(HALF_NS);
+}
+
+static void
+bus_stop(struct bus *b)
+{
+	line(b, b->sda, true);
+	spin_ns(HALF_NS);
+	scl_release(b);
+	spin_ns(HALF_NS);
+	line(b, b->sda, false);
+	spin_ns(HALF_NS);
+}
+
+/* one byte out; true if it was acknowledged */
+static bool
+bus_put(struct bus *b, uint8_t byte)
+{
+	bool ack;
+
+	for (int bit = 7; bit >= 0; bit--) {
+		line(b, b->sda, !(byte >> bit & 1));
+		spin_ns(HALF_NS);
+		scl_release(b);
+		spin_ns(HALF_NS);
+		line(b, b->scl, true);
+	}
+	line(b, b->sda, false);
+	spin_ns(HALF_NS);
+	scl_release(b);
+	spin_ns(HALF_NS);
+	ack = !level(b->sda);
+	line(b, b->scl, true);
+	spin_ns(HALF_NS);
+	return ack;
+}
+
+static uint8_t
+bus_get(struct bus *b, bool ack)
+{
+	uint8_t byte = 0;
+
+	line(b, b->sda, false);
+	for (int bit = 7; bit >= 0; bit--) {
+		spin_ns(HALF_NS);
+		scl_release(b);
+		spin_ns(HALF_NS);
+		byte = (uint8_t)(byte << 1 | level(b->sda));
+		line(b, b->scl, true);
+	}
+	if (ack) {
+		line(b, b->sda, true);
+	}
+	spin_ns(HALF_NS);
+	scl_release(b);
+	spin_ns(HALF_NS);
+	line(b, b->scl, true);
+	line(b, b->sda, false);
+	return byte;
+}
+
+/* `count` bytes from register `reg` of the chip at `address`: the register written, a repeated start, the read */
+static bool
+bus_read(struct bus *b, uint8_t address, uint8_t reg, uint8_t *data, unsigned count)
+{
+	bool ok;
+
+	bus_start(b);
+	ok = bus_put(b, (uint8_t)(address << 1)) && bus_put(b, reg);
+	if (ok) {
+		line(b, b->sda, false);         /* the repeated start: data high, clock high, data low */
+		spin_ns(HALF_NS);
+		scl_release(b);
+		spin_ns(HALF_NS);
+		line(b, b->sda, true);
+		spin_ns(HALF_NS);
+		line(b, b->scl, true);
+		spin_ns(HALF_NS);
+		ok = bus_put(b, (uint8_t)(address << 1 | 1));
+	}
+	for (unsigned i = 0; ok && i < count; i++) {
+		data[i] = bus_get(b, i + 1 < count);
+	}
+	bus_stop(b);
+	if (!ok) {
+		b->nacks++;
+	}
+	return ok;
+}
+
+/*
+ * Boot-arg battery_scan=1: which addresses on a bus answer a one-byte read (the read of a chip's
+ * current register: nothing changes), to see what is there and whether the bus works at all.
+ */
+static void
+bus_scan(struct bus *b)
+{
+	char line[300];
+	int n = 0;
+
+	for (unsigned address = 0x03; address <= 0x77; address++) {
+		uint8_t byte;
+		bool ok;
+
+		bus_start(b);
+		ok = bus_put(b, (uint8_t)(address << 1 | 1));
+		if (ok) {
+			byte = bus_get(b, false);
+		}
+		bus_stop(b);
+		if (ok && n < (int)sizeof(line) - 8) {
+			n += snprintf(line + n, sizeof(line) - (size_t)n, " %#x", address);
+		}
+	}
+	line[n] = 0;
+	printf("battery: %s bus: addresses that answer:%s\n", b->name, n ? line : " none");
+}
+
+/* The pins as plain GPIOs (an eGPIO claimed as such: see redwood_synaptics.c), at output level 0; a stuck data line freed. */
+static void
+bus_take(struct bus *b)
+{
+	uint32_t sda = rd(GPIO_CFG(b->sda)), scl = rd(GPIO_CFG(b->scl));
+
+	printf("battery: %s bus: gpio%u (data) cfg %#x reads %u, gpio%u (clock) cfg %#x reads %u\n", b->name, b->sda, sda,
+	    level(b->sda), b->scl, scl, level(b->scl));
+	b->keep_sda = (sda & CFG_EGPIO_PRESENT) ? CFG_EGPIO_PRESENT | CFG_EGPIO_ENABLE : 0;
+	b->keep_scl = (scl & CFG_EGPIO_PRESENT) ? CFG_EGPIO_PRESENT | CFG_EGPIO_ENABLE : 0;
+	wr(GPIO_IO(b->sda), 0);
+	wr(GPIO_IO(b->scl), 0);
+	line(b, b->sda, false);
+	line(b, b->scl, false);
+	delay(10);
+	for (int i = 0; i < 9 && !level(b->sda); i++) {
+		line(b, b->scl, true);
+		spin_ns(HALF_NS);
+		scl_release(b);
+		spin_ns(HALF_NS);
+	}
+	bus_stop(b);
+}
+
+/* ---- the gauge (BQ28Z610 at 0x55) ----------------------------------------------------------------- */
+
+#define GAUGE_ADDRESS           0x55
+#define GAUGE_TEMPERATURE       0x06            /* 0.1 K */
+#define GAUGE_VOLTAGE           0x08            /* mV, the pack's (both cells) */
+#define GAUGE_FLAGS             0x0a
+#define GAUGE_CURRENT           0x0c            /* mA, now (positive: charging) */
+#define GAUGE_REMAINING         0x10            /* mAh */
+#define GAUGE_FULL              0x12            /* mAh, as the gauge has learnt it */
+#define GAUGE_AVERAGE_CURRENT   0x14            /* mA */
+#define GAUGE_CYCLES            0x2a
+#define GAUGE_SOC               0x2c            /* % */
+#define GAUGE_HEALTH            0x2e            /* % */
+#define GAUGE_DESIGN            0x3c            /* mAh, as designed */
+
+static bool
+gauge_word(uint8_t reg, int32_t *value, bool is_signed)
+{
+	uint8_t data[2];
+
+	if (!bus_read(&gauge_bus, GAUGE_ADDRESS, reg, data, 2)) {
+		return false;
+	}
+	*value = is_signed ? (int16_t)(data[0] | data[1] << 8) : (int32_t)(data[0] | data[1] << 8);
+	return true;
+}
+
+/* ---- the charger (MP2650 at 0x5c) ------------------------------------------------------------------ */
+
+#define CHARGER_ADDRESS         0x5c
+#define CHARGER_STATUS          0x13            /* bit 1: 0 = the input is good; bits 3:2: 0 none, 1 pre-, 2 fast charge, 3 done */
+#define CHARGER_FAULTS          0x14            /* bit 7 watchdog, 5:4 charge fault, 3 battery overvoltage, 2:0 NTC */
+#define CHARGER_INPUT_VOLTAGE   0x1c            /* [15:6] x 25 mV */
+#define CHARGER_INPUT_CURRENT   0x1e            /* [15:6] x 6.25 mA */
+#define CHARGER_CHARGE_CURRENT  0x1a            /* [15:6] x 12.5 mA */
+#define CHARGER_BATTERY_VOLTAGE 0x16            /* [15:6] x 12.5 mV */
+
+static bool
+charger_byte(uint8_t reg, uint8_t *value)
+{
+	return bus_read(&charger_bus, CHARGER_ADDRESS, reg, value, 1);
+}
+
+static bool
+charger_adc(uint8_t reg, uint32_t step_hundredths, int32_t *value)
+{
+	uint8_t data[2];
+
+	if (!bus_read(&charger_bus, CHARGER_ADDRESS, reg, data, 2)) {
+		return false;
+	}
+	*value = (int32_t)(((uint32_t)(data[0] | data[1] << 8) >> 6) * step_hundredths / 100);
+	return true;
+}
+
+/* ---- the reading ------------------------------------------------------------------------------- */
+
+static void
+gauge_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	struct redwood_battery_state state;
+	uint8_t registers[0x16];
+	bool all = true, any = false, charging_seen = false, charging_stopped = false, every_tick;
+
+	uint32_t scan = 0, log_all = 0, readings = 0, charging_readings = 0;
+	int32_t first_soc = -1, most_in = -100000, most_out = 100000;
+
+	/* boot-arg battery_log=1: the gauge's line every 5 s, not every minute */
+	every_tick = PE_parse_boot_argn("battery_log", &log_all, sizeof(log_all)) && log_all;
+
+	tlmm = ml_io_map(TLMM_PHYS, TLMM_SIZE);
+	bus_take(&gauge_bus);
+	bus_take(&charger_bus);
+	if (PE_parse_boot_argn("battery_scan", &scan, sizeof(scan)) && scan) {
+		bus_scan(&gauge_bus);
+		bus_scan(&charger_bus);
+	}
+	/* the charger's settings as they are: its defaults, unless something has set it since the phone started */
+	for (unsigned reg = 0; reg < sizeof(registers); reg++) {
+		bool ok = charger_byte((uint8_t)reg, &registers[reg]);
+
+		all = all && ok;
+		any = any || ok;
+	}
+	if (any) {
+		printf("battery: charger registers 0x00..0x15%s:", all ? "" : " (not all could be read)");
+		for (unsigned reg = 0; reg < sizeof(registers); reg++) {
+			printf(" %02x", registers[reg]);
+		}
+		printf("\n");
+	} else {
+		printf("battery: no charger answers at %#x: charging is told from the gauge's current\n", CHARGER_ADDRESS);
+	}
+
+	for (unsigned tick = 0;; tick++) {
+		int32_t soc = -1, mv = 0, ma = 0, decikelvin = 0, flags = 0, remaining = 0, full = 0, design = 0, cycles = 0;
+		int32_t vin = 0, iin = 0, ichg = 0, vbat = 0;
+		uint8_t status = 0xff, faults = 0xff;
+		bool gauge_ok, charger_ok;
+
+		gauge_ok = gauge_word(GAUGE_SOC, &soc, false) && gauge_word(GAUGE_VOLTAGE, &mv, false) &&
+		    gauge_word(GAUGE_AVERAGE_CURRENT, &ma, true) && gauge_word(GAUGE_TEMPERATURE, &decikelvin, false) &&
+		    gauge_word(GAUGE_FLAGS, &flags, false);
+		if (gauge_ok) {
+			(void)gauge_word(GAUGE_REMAINING, &remaining, false);
+			(void)gauge_word(GAUGE_FULL, &full, false);
+			(void)gauge_word(GAUGE_CYCLES, &cycles, false);
+			(void)gauge_word(GAUGE_DESIGN, &design, false);
+		}
+		charger_ok = any && charger_byte(CHARGER_STATUS, &status) && charger_byte(CHARGER_FAULTS, &faults);
+		if (charger_ok) {
+			(void)charger_adc(CHARGER_INPUT_VOLTAGE, 2500, &vin);
+			(void)charger_adc(CHARGER_INPUT_CURRENT, 625, &iin);
+			(void)charger_adc(CHARGER_CHARGE_CURRENT, 1250, &ichg);
+			(void)charger_adc(CHARGER_BATTERY_VOLTAGE, 1250, &vbat);
+		}
+		/* what the run says on the panel at its end (redwood_dpu.c), for when its log does not come back */
+		if (gauge_ok) {
+			char note[48];
+
+			if (first_soc < 0) {
+				first_soc = soc;
+			}
+			readings++;
+			charging_readings += ma > 20;
+			most_in = ma > most_in ? ma : most_in;
+			most_out = ma < most_out ? ma : most_out;
+			redwood_dpu_note(0, "BATTERY (gauge, every 5 s)");
+			snprintf(note, sizeof(note), "%d%% at the start, %d%% now, %d mV", first_soc, soc, mv);
+			redwood_dpu_note(1, note);
+			snprintf(note, sizeof(note), "now %d mA, %d.%d C", ma, (decikelvin - 2731) / 10, ((decikelvin - 2731) % 10 + 10) % 10);
+			redwood_dpu_note(2, note);
+			snprintf(note, sizeof(note), "most in %d mA, most out %d mA", most_in, most_out);
+			redwood_dpu_note(3, note);
+			snprintf(note, sizeof(note), "charging in %u of %u readings", charging_readings, readings);
+			redwood_dpu_note(4, note);
+		}
+		/* the battery's current changing sides is said at once: charging begins or ends */
+		if (gauge_ok && (ma > 20) != charging_seen) {
+			charging_seen = ma > 20;
+			printf("battery: %s: %d mA, %d%%, %d mV\n", charging_seen ? "the battery takes charge" : "the battery takes no charge",
+			    ma, soc, mv);
+		}
+		if (tick % 12 == 0 || every_tick) {
+			printf("battery: gauge %s: %d%%, %d mV, %d mA, %d.%d C, flags %#x, %d of %d mAh (design %d), %d cycles; charger %s: "
+			    "status %#x faults %#x, in %d mV %d mA, charging %d mA, battery %d mV; %llu+%llu reads not acknowledged, "
+			    "%llu+%llu clock waits too long\n", gauge_ok ? "ok" : "NOT ANSWERING", soc, mv, ma,
+			    (decikelvin - 2731) / 10, ((decikelvin - 2731) % 10 + 10) % 10, flags, remaining, full, design, cycles,
+			    charger_ok ? "ok" : "NOT ANSWERING", status, faults, vin, iin, ichg, vbat, gauge_bus.nacks, charger_bus.nacks,
+			    gauge_bus.stretches, charger_bus.stretches);
+		}
+		/*
+		 * The charging is the audio DSP's (adsp=1), and the DSP does not read this battery's
+		 * temperature (it says 25 degrees, always) nor this gauge. So the gauge watches: charging
+		 * outside 0..45 C, or a cell above 4.40 V (the DSP's own limit is 4.35: 8.7 V for the pack),
+		 * and the DSP is shut down, which ends the charging without telling the charger anything.
+		 */
+		if (gauge_ok && ma > 20 && !charging_stopped) {
+			int32_t celsius = (decikelvin - 2731) / 10;
+
+			if (celsius > 45 || celsius < 0 || mv / 2 > 4400) {
+				charging_stopped = true;
+				redwood_dpu_note(7, "CHARGING STOPPED (temperature/voltage)");
+				printf("battery: CHARGING STOPPED: %d C, %d mV a cell while taking %d mA: the audio DSP, which charges, is "
+				    "shut down\n", celsius, mv / 2, ma);
+				redwood_adsp_stop();
+			}
+		}
+		if (gauge_ok && soc >= 0 && soc <= 100) {
+			int32_t usb_type = 0, usb_uv = 0, usb_ua = 0;
+			int usb = redwood_battmgr_usb(&usb_type, &usb_uv, &usb_ua);
+			/* plugged in: what the charger says if it answers, else what the DSP says, else the current alone */
+			bool input = charger_ok ? !(status & (1u << 1)) : usb >= 0 ? usb != 0 : ma > -50;
+			unsigned stage = charger_ok ? (status >> 2) & 3 : ma > 20 ? 2 : 0;
+
+			bzero(&state, sizeof(state));
+			state.size = sizeof(state);
+			state.percent_hundredths = soc * 100;
+			state.voltage_uv = mv * 1000 / 2;
+			state.current_ua = ma * 1000;
+			state.temperature_hundredths = (decikelvin - 2731) * 10;
+			state.present = 1;
+			state.external = input;
+			state.status = !input ? 2 : stage == 3 || soc >= 100 ? 4 : stage != 0 ? 1 : 3;
+			state.charge_uah = remaining * 1000;
+			state.full_uah = full * 1000;
+			state.design_uah = design * 1000;
+			state.cycles = cycles;
+			state.usb_type = usb > 0 ? usb_type : 0;
+			state.usb_voltage_uv = !input ? 0 : charger_ok ? vin * 1000 : usb_uv;
+			state.usb_current_ua = !input ? 0 : charger_ok ? iin * 1000 : usb_ua;
+			redwood_battery_report(&state);
+		}
+		delay_for_interval(5000, NSEC_PER_MSEC);
+	}
+}
+
+void
+redwood_gauge_start(void)
+{
+	thread_t thread;
+
+	printf("battery: lemonadep: the BQ28Z610 gauge (gpio12/13) and the MP2650 charger (gpio4/5), read every 5 s\n");
+	if (kernel_thread_start(gauge_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}

--- /dev/null
+++ b/bsd/dev/redwood_battery.c
@@ -0,0 +1,204 @@
+/*
+ * Battery monitor for Xiaomi redwood (POCO X5 Pro).
+ *
+ * Redwood selects PM7325B and qcom,battery-charger over PMIC GLINK/ADSP, not
+ * the local PM7250B/QG layout.  The resident UEFI contains the matching
+ * Qualcomm charger drivers.  xnuloader owns that firmware context on core 0,
+ * polls it, and publishes a read-only cache; XNU only consumes that cache.
+ * Charger limits and JEITA protection therefore remain firmware-owned.
+ */
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/redwood_input.h>
+#include <sys/sysctl.h>
+#include <sys/systm.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#define LOADER_BATTERY_MAGIC            0x2154544142574452ULL
+#define LOADER_BATTERY_VERSION          1
+#define LOADER_BATTERY_VALID            (1u << 0)
+#define LOADER_BATTERY_PRESENT          (1u << 1)
+#define LOADER_BATTERY_CHARGER_PRESENT  (1u << 2)
+#define LOADER_BATTERY_VOLTAGE_VALID    (1u << 3)
+#define LOADER_BATTERY_CHARGING         (1u << 4)
+#define LOADER_BATTERY_SOC_ESTIMATED    (1u << 5)
+#define LOADER_PAGE_SIZE                0x4000UL
+
+struct loader_battery {
+	uint64_t magic;
+	uint32_t version, size;
+	volatile uint32_t sequence;
+	uint32_t flags;
+	int32_t soc_percent, voltage_mv, current_ma, temperature_c;
+	uint32_t charger_action, polls, failures, reserved;
+};
+
+static volatile struct loader_battery *shared_battery;
+static int battery_soc_percent = -1, battery_voltage_mv = -1, battery_current_ma;
+static int battery_temperature_c = -273, battery_present, battery_charger_present;
+static int battery_charging, battery_soc_estimated, battery_charger_action = -1;
+static uint64_t battery_updates, battery_failures;
+
+/* for others in the kernel (the flashlight's thermal guard): -273 while it is not known */
+int
+redwood_battery_temperature(void)
+{
+	return battery_temperature_c;
+}
+
+SYSCTL_NODE(_kern, OID_AUTO, redwood, CTLFLAG_RW | CTLFLAG_LOCKED, 0, "redwood phone bits");
+SYSCTL_INT(_kern_redwood, OID_AUTO, battery_soc, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_soc_percent, 0, "battery state of charge, 0..100 percent, or -1 if unknown");
+SYSCTL_INT(_kern_redwood, OID_AUTO, battery_voltage_mv, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_voltage_mv, 0, "battery voltage in millivolts, or -1 if unknown");
+SYSCTL_INT(_kern_redwood, OID_AUTO, battery_current_ma, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_current_ma, 0, "battery current reported by Qualcomm firmware, in milliamps");
+SYSCTL_INT(_kern_redwood, OID_AUTO, battery_temperature_c, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_temperature_c, 0, "battery temperature reported by Qualcomm firmware, in Celsius");
+SYSCTL_INT(_kern_redwood, OID_AUTO, battery_present, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_present, 0, "1 if Qualcomm firmware reports a battery");
+SYSCTL_INT(_kern_redwood, OID_AUTO, battery_charger_present, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_charger_present, 0, "1 if Qualcomm firmware reports an attached charger");
+SYSCTL_INT(_kern_redwood, OID_AUTO, battery_charging, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_charging, 0, "1 while an attached charger is charging a non-full battery");
+SYSCTL_INT(_kern_redwood, OID_AUTO, battery_soc_estimated, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_soc_estimated, 0, "1 only when SOC had to be estimated from voltage");
+SYSCTL_INT(_kern_redwood, OID_AUTO, battery_charger_action, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_charger_action, 0, "last Qualcomm charger action, for diagnostics");
+
+static bool
+battery_snapshot(struct loader_battery *out)
+{
+	uint32_t before, after;
+
+	for (unsigned retry = 0; retry < 4; retry++) {
+		before = shared_battery->sequence;
+		if (before & 1) continue;
+		__asm__ volatile ("dmb ishld" ::: "memory");
+		memcpy(out, (const void *)(uintptr_t)shared_battery, sizeof(*out));
+		__asm__ volatile ("dmb ishld" ::: "memory");
+		after = shared_battery->sequence;
+		if (before == after && !(after & 1)) return true;
+	}
+	return false;
+}
+
+static void
+battery_poll(void)
+{
+	struct loader_battery sample;
+
+	if (!battery_snapshot(&sample) || sample.magic != LOADER_BATTERY_MAGIC ||
+	    sample.version != LOADER_BATTERY_VERSION || sample.size < sizeof(sample) ||
+	    !(sample.flags & LOADER_BATTERY_VALID) || sample.soc_percent < 0 || sample.soc_percent > 100) {
+		battery_failures++;
+		return;
+	}
+	battery_soc_percent = sample.soc_percent;
+	battery_voltage_mv = (sample.flags & LOADER_BATTERY_VOLTAGE_VALID) ? sample.voltage_mv : -1;
+	battery_current_ma = sample.current_ma;
+	battery_temperature_c = sample.temperature_c;
+	battery_present = (sample.flags & LOADER_BATTERY_PRESENT) != 0;
+	battery_charger_present = (sample.flags & LOADER_BATTERY_CHARGER_PRESENT) != 0;
+	battery_charging = (sample.flags & LOADER_BATTERY_CHARGING) != 0;
+	battery_soc_estimated = (sample.flags & LOADER_BATTERY_SOC_ESTIMATED) != 0;
+	battery_charger_action = (int)sample.charger_action;
+	battery_updates++;
+}
+
+/*
+ * What the audio DSP's battery manager says (bsd/dev/redwood_adsp.c, with adsp=1 unless battmgr=0):
+ * the values that Android shows, from where Android takes them. They are kept here for the sysctls
+ * and passed on to the power source that iOS reads (iokit/Kernel/RedwoodBattery.cpp).
+ */
+static int battery_full_uah, battery_design_uah, battery_cycles, battery_source_dsp;
+
+SYSCTL_INT(_kern_redwood, OID_AUTO, battery_full_uah, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_full_uah, 0, "the battery's full charge as the fuel gauge has learnt it, in uAh (0 if unknown)");
+SYSCTL_INT(_kern_redwood, OID_AUTO, battery_design_uah, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_design_uah, 0, "the battery's charge as designed, in uAh (0 if unknown)");
+SYSCTL_INT(_kern_redwood, OID_AUTO, battery_cycles, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_cycles, 0, "the battery's charge cycles (0 if unknown)");
+SYSCTL_INT(_kern_redwood, OID_AUTO, battery_from_dsp, CTLFLAG_RD | CTLFLAG_LOCKED,
+    &battery_source_dsp, 0, "1 when the values come from the audio DSP's battery manager");
+
+extern void RedwoodBatteryReport(const void *state, unsigned size);     /* iokit/Kernel/RedwoodBattery.cpp */
+
+void
+redwood_battery_report(const struct redwood_battery_state *b)
+{
+	int percent = (b->percent_hundredths + 50) / 100;
+
+	battery_soc_percent = percent < 0 ? 0 : percent > 100 ? 100 : percent;
+	battery_voltage_mv = b->voltage_uv / 1000;
+	battery_current_ma = b->current_ua / 1000;
+	battery_temperature_c = (b->temperature_hundredths + 50) / 100;
+	battery_present = b->present != 0;
+	battery_charger_present = b->external != 0;
+	battery_charging = b->status == 1;      /* POWER_SUPPLY_STATUS_CHARGING */
+	battery_soc_estimated = 0;
+	battery_charger_action = b->status;
+	if (b->full_uah > 0) {
+		battery_full_uah = b->full_uah;
+	}
+	if (b->design_uah > 0) {
+		battery_design_uah = b->design_uah;
+	}
+	if (b->cycles > 0) {
+		battery_cycles = b->cycles;
+	}
+	battery_source_dsp = 1;
+	battery_updates++;
+	RedwoodBatteryReport(b, sizeof(*b));
+}
+
+static void
+battery_thread(__unused void *parameter, __unused wait_result_t result)
+{
+	for (unsigned tick = 0;; tick++) {
+		battery_poll();
+		if (tick % 12 == 0) {
+			printf("battery: SOC=%d%%%s, V=%d mV, I=%d mA, T=%d C, battery=%d charger=%d charging=%d "
+			    "action=%d (%llu reads, %llu failed)\n", battery_soc_percent,
+			    battery_soc_estimated ? " (voltage estimate)" : "", battery_voltage_mv,
+			    battery_current_ma, battery_temperature_c, battery_present, battery_charger_present,
+			    battery_charging, battery_charger_action, battery_updates, battery_failures);
+		}
+		delay_for_interval(5000, NSEC_PER_MSEC);
+	}
+}
+
+void
+redwood_battery_init(void)
+{
+	uint32_t enabled = 0;
+	uint64_t shared_pa = 0;
+	vm_offset_t page;
+	thread_t thread;
+	char board[32];
+
+	if (!PE_parse_boot_argn("battery", &enabled, sizeof(enabled)) || !enabled) return;
+	if (PE_parse_boot_arg_str("board", board, sizeof(board)) && strcmp(board, "lemonadep") == 0) {
+		/* the 9 Pro: its gauge and charger are on I2C buses of ours, not behind Qualcomm's charger firmware */
+		redwood_gauge_start();
+		return;
+	}
+	if (!PE_parse_boot_argn("battery_shared_pa", &shared_pa, sizeof(shared_pa)) || shared_pa == 0) {
+		printf("battery: xnuloader did not provide battery_shared_pa\n");
+		return;
+	}
+	page = ml_io_map((vm_offset_t)(shared_pa & ~(LOADER_PAGE_SIZE - 1)), LOADER_PAGE_SIZE);
+	shared_battery = (volatile struct loader_battery *)(page + (shared_pa & (LOADER_PAGE_SIZE - 1)));
+	if (shared_battery->magic != LOADER_BATTERY_MAGIC || shared_battery->version != LOADER_BATTERY_VERSION ||
+	    shared_battery->size < sizeof(struct loader_battery)) {
+		printf("battery: bad xnuloader cache at %#llx (magic %#llx version %u size %u)\n", shared_pa,
+		    shared_battery->magic, shared_battery->version, shared_battery->size);
+		return;
+	}
+	printf("battery: Qualcomm UEFI cache at pa %#llx; polling every 5 seconds\n", shared_pa);
+	if (kernel_thread_start(battery_thread, NULL, &thread) == KERN_SUCCESS) thread_deallocate(thread);
+}

--- /dev/null
+++ b/iokit/Kernel/arm/RedwoodBattery.cpp
@@ -0,0 +1,230 @@
+/*
+ * RedwoodBattery: the phone's battery as iOS looks for it, an IOPMPowerSource.
+ *
+ * powerd finds every service of the class IOPMPowerSource (it calls the first "InternalBattery-0"),
+ * listens for its kIOPMMessageBatteryStatusHasChanged and then reads its properties: whether a
+ * battery is installed, CurrentCapacity and MaxCapacity (without both it gives up on the battery),
+ * whether a charger is connected and charging, voltage, current, cycles, the charger's details.
+ * From them it makes the power sources list (IOPSCopyPowerSourcesInfo) and posts its notifications,
+ * and everything else follows from that: the status bar's battery, the lock screen's "Charging",
+ * the Batteries widget, Settings > Battery.
+ *
+ * What the values are comes from the audio DSP's battery manager (bsd/dev/redwood_adsp.c,
+ * with adsp=1, unless battmgr=0), by way of bsd/dev/redwood_battery.c, which calls
+ * RedwoodBatteryReport() with every reading; the first one makes the service. Nothing here asks
+ * the charger anything or tells it anything.
+ *
+ * As on Apple's newer batteries, CurrentCapacity is the percentage that the fuel gauge shows (and
+ * MaxCapacity 100); the charges in mAh are AppleRawCurrentCapacity, AppleRawMaxCapacity (what the
+ * gauge has learnt a full charge to be), NominalChargeCapacity and DesignCapacity.
+ */
+
+#include <IOKit/IOLib.h>
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/pwr_mgt/IOPM.h>
+#include <IOKit/pwr_mgt/IOPMPowerSource.h>
+#include <libkern/c++/OSBoolean.h>
+#include <libkern/c++/OSDictionary.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSSymbol.h>
+
+/* The same as struct redwood_battery_state in bsd/sys/redwood_input.h, which is not seen from here. */
+struct redwood_battery_state {
+	uint32_t size;
+	int32_t percent_hundredths;
+	int32_t voltage_uv;
+	int32_t current_ua;             /* more than 0 while the battery takes charge */
+	int32_t temperature_hundredths;
+	int32_t present, external, status;
+	int32_t charge_uah, full_uah, design_uah, cycles;
+	int32_t usb_type;
+	int32_t usb_voltage_uv, usb_current_ua;
+};
+
+extern "C" void RedwoodBatteryReport(const void * state, unsigned size);
+
+class RedwoodBattery : public IOPMPowerSource
+{
+	OSDeclareDefaultStructors(RedwoodBattery);
+
+public:
+	void report(const struct redwood_battery_state * b);
+
+private:
+	void number(const char * key, long long value);
+	void flag(const char * key, bool value);
+	void object(const char * key, OSObject * value);
+};
+
+OSDefineMetaClassAndStructors(RedwoodBattery, IOPMPowerSource);
+
+static RedwoodBattery * battery;
+
+void
+RedwoodBattery::number(const char * key, long long value)
+{
+	const OSSymbol * symbol = OSSymbol::withCString(key);
+	OSNumber * n = OSNumber::withNumber((unsigned long long) value, 32);
+
+	if (symbol != NULL && n != NULL) {
+		setPSProperty(symbol, n);
+	}
+	OSSafeReleaseNULL(n);
+	OSSafeReleaseNULL(symbol);
+}
+
+void
+RedwoodBattery::flag(const char * key, bool value)
+{
+	const OSSymbol * symbol = OSSymbol::withCString(key);
+
+	if (symbol != NULL) {
+		setPSProperty(symbol, value ? kOSBooleanTrue : kOSBooleanFalse);
+	}
+	OSSafeReleaseNULL(symbol);
+}
+
+void
+RedwoodBattery::object(const char * key, OSObject * value)
+{
+	const OSSymbol * symbol = OSSymbol::withCString(key);
+
+	if (symbol != NULL && value != NULL) {
+		setPSProperty(symbol, value);
+	}
+	OSSafeReleaseNULL(symbol);
+}
+
+/*
+ * What iOS calls the charger by (IOPSKeysPrivate.h's kIOPSFamilyCode*, iokit_family_err(sub_iokit_usb, n)),
+ * from Linux's POWER_SUPPLY_USB_TYPE_*, as the DSP gives it.
+ */
+static unsigned
+family_code(int usb_type)
+{
+	switch (usb_type) {
+	case 1: return 0xe0004000;      /* SDP, a computer's port: kIOPSFamilyCodeUSBHost */
+	case 2: return 0xe0004004;      /* DCP, a charger: kIOPSFamilyCodeUSBChargingPortDedicated */
+	case 3: return 0xe0004005;      /* CDP, a computer's charging port: kIOPSFamilyCodeUSBChargingPortDownstream */
+	case 5: return 0xe0004009;      /* USB-C: kIOPSFamilyCodeUSBCTypeC */
+	case 6: case 7: case 8: return 0xe000400a;      /* USB Power Delivery: kIOPSFamilyCodeUSBCPD */
+	default: return 0xe0004007;     /* kIOPSFamilyCodeUSBUnknown */
+	}
+}
+
+void
+RedwoodBattery::report(const struct redwood_battery_state * b)
+{
+	int percent = (b->percent_hundredths + 50) / 100;
+	bool charging = b->external && b->status == 1;          /* POWER_SUPPLY_STATUS_CHARGING */
+
+	percent = percent < 0 ? 0 : percent > 100 ? 100 : percent;
+	setBatteryInstalled(b->present != 0);
+	setExternalConnected(b->external != 0);
+	setExternalChargeCapable(b->external != 0);
+	setIsCharging(charging);
+	flag("FullyCharged", b->external && (b->status == 4 || percent == 100));    /* POWER_SUPPLY_STATUS_FULL */
+	flag("AppleRawExternalConnected", b->external != 0);
+	setCurrentCapacity((unsigned) percent);
+	setMaxCapacity(100);
+	setVoltage((unsigned) (b->voltage_uv / 1000));
+	setAmperage(b->current_ua / 1000);
+	number("InstantAmperage", b->current_ua / 1000);
+	number("Temperature", b->temperature_hundredths);
+	if (b->charge_uah > 0) {
+		number("AppleRawCurrentCapacity", b->charge_uah / 1000);
+	}
+	if (b->full_uah > 0) {
+		number("AppleRawMaxCapacity", b->full_uah / 1000);
+		number("NominalChargeCapacity", b->full_uah / 1000);
+	}
+	if (b->design_uah > 0) {
+		number("DesignCapacity", b->design_uah / 1000);
+	}
+	if (b->cycles > 0) {
+		setCycleCount((unsigned) b->cycles);
+	}
+
+	if (b->external) {
+		OSDictionary * adapter = OSDictionary::withCapacity(6);
+		long long mv = b->usb_voltage_uv / 1000, ma = b->usb_current_ua / 1000;
+		OSNumber * n;
+
+		if (adapter != NULL) {
+			if ((n = OSNumber::withNumber((unsigned long long) ((mv * ma + 500000) / 1000000), 32)) != NULL) {
+				adapter->setObject(kIOPMPSAdapterDetailsWattsKey, n);
+				n->release();
+			}
+			if ((n = OSNumber::withNumber((unsigned long long) ma, 32)) != NULL) {
+				adapter->setObject(kIOPMPSAdapterDetailsAmperageKey, n);
+				n->release();
+			}
+			if ((n = OSNumber::withNumber((unsigned long long) mv, 32)) != NULL) {
+				adapter->setObject(kIOPMPSAdapterDetailsVoltage, n);
+				n->release();
+			}
+			if ((n = OSNumber::withNumber((unsigned long long) family_code(b->usb_type), 32)) != NULL) {
+				adapter->setObject(kIOPMPSAdapterDetailsFamilyKey, n);
+				n->release();
+			}
+			adapter->setObject("IsWireless", kOSBooleanFalse);
+			object(kIOPMPSAdapterDetailsKey, adapter);
+			adapter->release();
+		}
+	} else {
+		OSDictionary * none = OSDictionary::withCapacity(1);
+		OSNumber * n = OSNumber::withNumber(0ULL, 32);    /* kIOPSFamilyCodeDisconnected */
+
+		if (none != NULL && n != NULL) {
+			none->setObject(kIOPMPSAdapterDetailsFamilyKey, n);
+			object(kIOPMPSAdapterDetailsKey, none);
+		}
+		OSSafeReleaseNULL(n);
+		OSSafeReleaseNULL(none);
+	}
+	updateStatus();
+}
+
+/* With every reading of the battery (bsd/dev/redwood_battery.c); the first one makes the service. One caller at a time. */
+void
+RedwoodBatteryReport(const void * state, unsigned size)
+{
+	const struct redwood_battery_state * b = (const struct redwood_battery_state *) state;
+	IOService * platform;
+
+	if (size != sizeof(struct redwood_battery_state) || b->size != sizeof(struct redwood_battery_state)) {
+		static bool said;
+
+		if (!said) {
+			said = true;
+			IOLog("RedwoodBattery: the battery's state is %u bytes, not %lu: bsd/sys/redwood_input.h and this file disagree\n",
+			    size, sizeof(struct redwood_battery_state));
+		}
+		return;
+	}
+	if (battery == NULL) {
+		RedwoodBattery * made = OSTypeAlloc(RedwoodBattery);
+
+		if ((platform = IOService::getPlatform()) == NULL || made == NULL || !made->init()) {
+			OSSafeReleaseNULL(made);
+			return;
+		}
+		made->report(b);        /* (the properties are there before anybody finds the service) */
+		if (!made->attach(platform)) {
+			made->release();
+			return;
+		}
+		made->setName("RedwoodBattery");
+		if (!made->start(platform)) {
+			made->detach(platform);
+			made->release();
+			return;
+		}
+		made->registerService();
+		battery = made;
+		IOLog("RedwoodBattery: the battery's power source is up: %d%%, %s\n", (b->percent_hundredths + 50) / 100,
+		    b->external ? (b->status == 1 ? "charging" : "on a charger, not charging") : "not on a charger");
+		return;
+	}
+	battery->report(b);
+}


+        !output_width(a->config.output_bits) || !a->config.leaf_budget ||
+        !a->capacity_pages || a->capacity_pages>SIZE_MAX/4096 ||
+        a->capacity_pages*4096>UINTPTR_MAX-(uintptr_t)a->mapping)return ArmSmmu4KArgument;

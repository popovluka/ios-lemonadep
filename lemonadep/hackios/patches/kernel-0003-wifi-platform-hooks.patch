  * in between (as redwood_adreno.c does with what it shares with the GPU); the first, cached
  * view is written out and never used again.
  */
+/*
+ * The piece taken early (redwood_lx_reserve()), before the GPU and the rest have cut memory up:
+ * on lemonadep 64 MB in one piece were not to be had any more by the time the radio came up.
+ */
+static vm_offset_t lx_reserved;
+static unsigned long lx_reserved_size;
+
+void
+redwood_lx_reserve(unsigned long size)
+{
+	size = round_page(size);
+	if (lx_reserved == 0 && kmem_alloc_contig(kernel_map, &lx_reserved, size, 0, 0, 0, KMA_KOBJECT | KMA_ZERO | KMA_DATA,
+	    VM_KERN_MEMORY_IOKIT) == KERN_SUCCESS) {
+		lx_reserved_size = size;
+	}
+	printf("lx: %lu MB in one piece taken early for the radio: %s\n", size >> 20, lx_reserved != 0 ? "yes" : "NO");
+}
+

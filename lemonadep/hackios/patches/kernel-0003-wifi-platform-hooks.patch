diff --git a/xnu/files/bsd/sys/redwood_qrtr.h b/xnu/files/bsd/sys/redwood_qrtr.h
index 0756558..8f56428 100644
--- a/xnu/files/bsd/sys/redwood_qrtr.h
+++ b/xnu/files/bsd/sys/redwood_qrtr.h
@@ -46,4 +46,20 @@ struct redwood_qrtr_ops {
 /* The transport there is; NULL takes it away (handles made before keep the one they were made with). */
 void redwood_qmi_set_transport(const struct redwood_qrtr_ops *ops);
 
+/*
+ * Another phone's radio under the same driver (lemonadep: a QCA6490 on PCIe, QRTR over MHI's IPCR
+ * channels): what bsd/dev/redwood_wifi.c asks the phone for, answered by that phone's code. Set,
+ * the QMI helpers have the router, and the driver (redwood_lx.c) its memory, files and options
+ * from here.
+ */
+struct redwood_wifi_platform {
+	bool (*radio_map)(uint64_t physical, uint64_t size, unsigned long long *address);
+	bool (*up)(void);                                       /* the firmware is running and the link is up */
+	int (*qrtr_send)(const void *packet, uint32_t length); /* one whole QRTR packet, header included */
+	const uint8_t *(*file)(const char *name, uint64_t *size);
+	bool (*option)(const char *name, uint32_t *value);      /* an option of its own, or false: the boot-args */
+};
+void redwood_wifi_platform_set(const struct redwood_wifi_platform *platform);
+void redwood_wifi_qrtr_deliver(const void *data, uint32_t length);
+
 #endif /* _SYS_REDWOOD_QRTR_H_ */

+	if (lx_reserved != 0 && size == lx_reserved_size) {
+		cached = lx_reserved;
+		lx_reserved = 0;
+	} else if (kmem_alloc_contig(kernel_map, &cached, size, 0, 0, 0, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) !=
 	    KERN_SUCCESS) {

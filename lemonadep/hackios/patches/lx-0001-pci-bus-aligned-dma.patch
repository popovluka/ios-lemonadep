+/*
+ * PCI (pci.c: ath11k_pci_window_read32() and _write32(), no static windows on this chip): below
+ * 512K straight through BAR0, above through the window register and the second 512K. The window
+ * and the access after it go together: one at a time.
+ */
+static void
+pci_hold(void)
+{
+	while (__atomic_test_and_set(&bus.window_held, __ATOMIC_ACQUIRE)) {
+		;
+	}
+}
+
+static void
+pci_let_go(void)
+{
+	__atomic_clear(&bus.window_held, __ATOMIC_RELEASE);
+}
+
+static u32
+pci_window(struct ath11k_base *ab, u32 offset)
+{
+	u32 w = FIELD_GET(ATH11K_PCI_WINDOW_VALUE_MASK, offset);
+
+	if (offset < ATH11K_PCI_WINDOW_START) {
+		return (offset);
+	}
+	if (w != bus.window_now) {
+		iowrite32(ATH11K_PCI_WINDOW_ENABLE_BIT | w, (u8 *)ab->mem + ATH11K_PCI_WINDOW_REG_ADDRESS);
+		(void)ioread32((u8 *)ab->mem + ATH11K_PCI_WINDOW_REG_ADDRESS);
+		bus.window_now = w;
+	}
+	return (ATH11K_PCI_WINDOW_START + (offset & ATH11K_PCI_WINDOW_RANGE_MASK));
+}

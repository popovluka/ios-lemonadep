 }
 
 /*
+ * The skeleton's 'F' files once more, after the store is back: settings the image means to hold
+ * whatever the last boot saved (lemonadep: Location Services on, see build.sh LOCATION_ON).
+ */
+static void
+forced_files(void)
+{
+	static char skeleton[16384];
+	int count = 0;
+
+	read_whole(in_image("/etc/var.skel"), skeleton, sizeof(skeleton));
+	for (char *line = skeleton; *line;) {
+		char *end = strchr(line, '\n'), *f[6];
+
+		if (end) {
+			*end = 0;
+		}
+		if (split_tabs(line, f, 6) == 6 && f[0][0] == 'F') {
+			if (copy_file(in_image(f[5]), f[4], (int)parse_number(f[1], 8), (int)parse_number(f[2], 10),
+			    (int)parse_number(f[3], 10))) {
+				count++;
+			} else {
+				printf("  %s: %s\n", f[4], strerror(errno));
+			}
+		}
+		if (!end) {
+			break;
+		}
+		line = end + 1;
+	}
+	if (count != 0) {
+		printf("  %d file(s) of the image put back over the data volume\n", count);
+	}
+}
+
+/*
  * What the last boot left in /private/var, back out of the phone's flash (var_store=1): the
  * memory filesystem is empty at every boot, so everything iOS writes -- the home screen's layout,
  * the applications' own data, the snapshots and the baked wallpaper -- would otherwise be new
@@ -1443,6 +1479,7 @@
 	show_system();
 	mount_writable();
 	restore_var();
+	forced_files();
 	test_files();
 	test_writable();
 	test_memory();

+	# CAPTIVE_OFF=1: iOS's captive-portal evaluation switched off (com.apple.captive.control, Active = false):
+	# on lemonadep it never leaves Stage "Evaluate" after a successful probe, and apps count Wi-Fi as offline
+	if [ -n "$CAPTIVE_OFF" ]; then
+		mkdir -p root/var/preferences/SystemConfiguration
+		python3 -c 'import plistlib, sys; plistlib.dump({"Active": False}, open(sys.argv[1], "wb"))' \
+			root/var/preferences/SystemConfiguration/com.apple.captive.control.plist
+		printf 'f\t644\t0\t0\t/private/var/preferences/SystemConfiguration/com.apple.captive.control.plist\t/var/preferences/SystemConfiguration/com.apple.captive.control.plist\n' >> root/etc/var.skel
+	fi
+	# LOCATION_ON=1: Location Services on (locationd: "location disabled system-wide" otherwise, and Settings
+	# shows no switch for it on this phone). The preference locationd reads: LocationServicesEnabledIn8.0
+	# (iOS 16's locationd; the 7.0 key is the older name).
+	if [ -n "$LOCATION_ON" ]; then
+		mkdir -p root/var/mobile/Library/Preferences
+		python3 -c 'import plistlib, sys; plistlib.dump({"LocationServicesEnabledIn8.0": True, "LocationServicesEnabledIn7.0": True}, open(sys.argv[1], "wb"))' \
+			root/var/mobile/Library/Preferences/com.apple.locationd.plist
+		printf 'F\t600\t501\t501\t/private/var/mobile/Library/Preferences/com.apple.locationd.plist\t/var/mobile/Library/Preferences/com.apple.locationd.plist\n' >> root/etc/var.skel
+	fi

+/*
+ * Standalone boot, no computer: payload item "diskrd" = "NAME OFFSET" (OFFSET in hex bytes). At
+ * OFFSET in GPT partition NAME a 4 KB header -- "XNURDISK", u64 size of the image -- and the image
+ * right after it, which is read to the resident address where "oem ramdisk" would have put it.
+ * Through a bounce buffer: whatever the UFS driver does about caches, the copy is the CPU's own.
+ */
+static int
+disk_ramdisk(const char *args)
+{
+	static const efi_guid part_guid = EFI_PARTITION_INFO_GUID;
+	static const efi_guid blk_guid = EFI_BLOCK_IO_GUID;
+	static const char magic[8] = { 'X', 'N', 'U', 'R', 'D', 'I', 'S', 'K' };

-UEFI_FD=                        # a built SILICIUM_UEFI.fd; empty: Mu-Silicium/Build/<target>Pkg/... or prebuilt/uefi
-DTB=none                        # none: ABL uses the phone's own (vendor_boot), not the OnePlus 9's
+UEFI_FD=/root/hakios/fz/Mu-Silicium/Build/lemonadepPkg/RELEASE_CLANGPDB/FV/SILICIUM_UEFI.fd   # the FD that reached the Silicium screen
+DTB=/root/hakios/fz/Mu-Silicium/Resources/DTBs/lemonadep.dtb   # the OnePlus 9 tree: without it the phone went to 900E crash dump (ios-sweet HANDOFF 2026-10-29)
 BOOT_ARGS="--os_version 17.0.0 --os_patch_level 2035-06 --cmdline console=null"   # as the ios-sweet shim
 # display test: -DFB_TEST_BASE=0xE4D00000 -DFB_TEST_STRIDE=4320 makes the boot shim paint a red band
 # into ABL's framebuffer before anything else runs (see FbBandDxe in the UEFI port)
@@ -33,9 +33,9 @@ WIFI_ATH11K=0                   # 1: build the ath11k Wi-Fi driver into the kern
 # touch_power=1: the Synaptics S3908, its supply switched on through RPMh (ldoc3) and its two
 # enable pins (bsd/dev/redwood_synaptics.c). Since then: gpu=1 (Adreno 660), battery=1 (BQ28Z610 gauge),
 # backlight=1 (DCS brightness), adsp=1 (the audio DSP, which charges); docs/lemonadep.md. No Wi-Fi or sound yet.
-BOOTARGS="cpus=8 bootcpu=7 cpufreq=1 buttons=1 touchscreen=1 touch_power=1 gpu=1 battery=1 backlight=1 adsp=1"  # gpu=1: needs fw-gpu/ (from vendor_a); battery=1: the BQ28Z610 gauge; backlight=1: brightness by DCS 0x51; adsp=1: the audio DSP, which charges (needs fw-audio/ from modem_a)
+BOOTARGS="cpus=8 bootcpu=7 cpufreq=1 buttons=1 touchscreen=1 touch_power=1 gpu=1 battery=1 backlight=1 adsp=1 sweetwlan=17 wlan_msi=1 wlan_ath=1 wifi_join=1 wifi=1"  # Wi-Fi: QCA6490 + ath11k, joins fw/network (lemonadep_wlan.c); gpu=1: needs fw-gpu/ (from vendor_a); battery=1: the BQ28Z610 gauge; backlight=1: brightness by DCS 0x51; adsp=1: the audio DSP, which charges (needs fw-audio/ from modem_a)
 DEFAULT_SECS=900
-USERLAND_VARS="GL=1 ADSP=1"     # extra variables for userland/build.sh: GL=1, Mesa for the Adreno 660 (gpu=1); ADSP=1, the audio DSP image in the small image (adsp=1)
+USERLAND_VARS="GL=1 ADSP=1 DENY_EXTRA=com.apple.apsd"     # extra variables for userland/build.sh: GL=1, Mesa for the Adreno 660 (gpu=1); ADSP=1, the audio DSP image in the small image (adsp=1); DENY_EXTRA=com.apple.apsd: without it Safari's History service hangs in [APSConnection setDelegate:] and Safari freezes after every page
 # The phone's own firmware, taken off it through the loader (never in the repository): docs/lemonadep.md.
 FIRMWARE=""

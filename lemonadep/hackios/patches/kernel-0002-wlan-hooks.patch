+/*
+ * iOS's own power off and restart (Settings, the power menu): no machine to halt here, so back to
+ * the loader, saying which in the log -- a standalone loader (payload item "diskrd") powers the
+ * phone off or starts it again by that line. A panic's restart is left to the panic path.
+ */
+extern int (*PE_halt_restart)(unsigned int type);
+extern void redwood_wifi_stop(void);
+extern void redwood_adsp_stop(void);
+extern void redwood_adreno_stop(void);
+
+static int
+loader_halt_restart(unsigned int type)
+{
+	const char *banner;
+
+	if (type == 0 /* kPEHaltCPU */) {
+		banner = "\n--- iOS asked to power off: back to the loader ---\n";
+	} else if (type == 1 /* kPERestartCPU */) {
+		banner = "\n--- iOS asked for a restart: back to the loader ---\n";
+	} else {
+		return 0;
+	}
+	for (const char *c = banner; *c; c++) {
+		loader_log_putc(*c);
+	}
+	redwood_adreno_stop();
+	redwood_wifi_stop();
+	redwood_adsp_stop();
+	loader_return();
+	return 0;
+}
+
+__startup_func
+static void
+loader_halt_restart_init(void)
+{
+	if (PE_halt_restart == NULL) {
+		PE_halt_restart = loader_halt_restart;
+	}
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_LAST, loader_halt_restart_init);
+
 __startup_func
 static void
 loader_return_timer_init(void)
